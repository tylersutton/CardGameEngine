root = true

[*.cs]
indent_style = space
indent_size = 4

# Explicit types instead of var.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# new() when the type is already written.
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning

# Braces on every if, else, for, foreach and while.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# [] for collections (but not for .ToList() and the like).
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0305.severity = none
