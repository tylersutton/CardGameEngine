{
	"rules": {
		"title": "Connect Four",
		"description": "You play Red against a Yellow bot. Click a column to drop a disc into it: it falls to the lowest empty space. Four of your discs in a line, across, down or diagonally, wins. A full board is a draw.",
		"zones": {
			"space": {
				"board": {
					"shape": "square",
					"columns": 7.0,
					"rows": 6.0,
					"size": 70.0,
					"paint": {
						"any_space": "#2456a8"
					}
				},
				"anchor": [
					0.5,
					0.5
				]
			},
			"supply": {
				"layout": "pile",
				"outline": false,
				"anchor": [
					-0.3,
					0.5
				],
				"cards": "res://decks/connect_four.csv"
			}
		},
		"actions": {
			"Drop": {
				"click": "space",
				"when": "landing_space != null",
				"steps": [
					"landed = landing_space",
					"move(top(where(supply, 'name', my_color)), landed)",
					{
						"if": "in_a_row(landed, 'mine') >= 4",
						"then": [
							"end_game(player)"
						],
						"else": [
							{
								"if": "count(space) == 42",
								"then": [
									"end_game()"
								]
							}
						]
					}
				]
			}
		},
		"triggers": {},
		"effects": {},
		"conditions": {
			"my_color": "'Red' if player == 1 else 'Yellow'",
			"mine": "text(top(space), 'name') == my_color",
			"in_clicked_column": "space.column == clicked_zone.column",
			"landing_space": "space_at(space, clicked_zone.column, 6 - count(zones_where(space, 'in_clicked_column')))",
			"any_space": "true"
		},
		"condition_parameters": {
			"my_color": [],
			"mine": [
				"space"
			],
			"in_clicked_column": [
				"space"
			],
