					0.64
				]
			}
		},
		"actions": {
			"Play a set": {
				"choose": "hand",
				"up_to": "count(hand)",
				"allow": "count(choice) > 0 and size(groups(choice, 'value')) == 1 and count(zones_where(all_set, 'blocks_play')) == 0",
				"steps": [
					{
						"for": "beaten",
						"in": "zones_where(all_set, 'beaten_by_play')",
						"do": [
							"from_seat = beaten.owner",
							"trigger('beaten')"
						]
					},
					"log('%s plays %d × %s' % [name_of(player), count(choice), text(top(choice), 'value')])",
					"move(choice, set)",
					"trigger('maybe_out')"
				]
			},
			"Add a card": {
				"drag": {
					"from": "hand",
					"to": "all_set"
				},
				"when": "count(to) > 0 and to.owner != player and card.value == set_value(to) and count(zones_where(all_set, 'blocks_add')) == 0",
				"steps": [
					"log('%s adds a %s to %s\\'s set' % [name_of(player), card.value, name_of(to.owner)])",
					{
						"for": "beaten",
						"in": "zones_where(all_set, 'beaten_by_add')",
						"do": [
							"from_seat = beaten.owner",
							"trigger('beaten')"
						]
					},
					"trigger('maybe_out')"
				]
			},
			"Take a set": {
				"click": "all_set",
				"when": "count(clicked_zone) > 0 and clicked_zone.owner != player",
				"steps": [
					"log('%s takes %s\\'s set' % [name_of(player), name_of(clicked_zone.owner)])",
					"from_seat = clicked_zone.owner",
					"to_seat = player",
					"trigger('turn_round_into_hand')"
				]
			},
			"Rotate hand": {
				"when": "count(hand) > 0",
				"steps": [
					"log('%s rotates their hand' % [name_of(player)])",
					{
						"for": "held",
						"in": "hand",
						"do": [
							"swap(held, other_side(held))"
						]
					}
				]
			},
			"Next round": {
				"human_only": true,
				"steps": []
			}
		},
		"triggers": {
			"start": [
				{
					"for": "player",
					"in": "players",
					"do": [
						"sort(hand, ['value'])"
					]
				},
				"trigger('deal')"
			],
			"deal": [
				"move([all_hand, all_set, discard], box)",
				"move(matching(box, 'in_play'), deck)",
				"shuffle(deck)",
				"deal(deck, all_hand, 8)",
				"bring_back(players)",
				"reset(['first_out', 'round_ended', 'out_set_turns'])",
				"player = owner(top(where(all_hand, 'star', 'yes')))"
			],
			"turn_round_into_hand": [
				{
					"for": "taken",
					"in": "set[from_seat]",
					"do": [
						"swap(taken, other_side(taken))"
					]
				},
				"move(set[from_seat], hand[to_seat])"
			],
			"beaten": [
				{
					"if": "from_seat == first_out",
					"then": [
						"move(set[from_seat], discard)"
					],
					"else": [
						"to_seat = from_seat",
						"trigger('turn_round_into_hand')"
					]
				}
			],
			"maybe_out": [
				{
					"if": "count(hand) == 0",
					"then": [
						{
							"if": "first_out == 0",
							"then": [
								"log('%s is out first: 2 points' % [name_of(player)])",
								"points += 2",
								"first_out = player",
								"knock_out(player)",
								"out_set_turns = size(players_left()) + 1"
							],
							"else": [
								"log('%s is out second: 1 point, and the round ends' % [name_of(player)])",
								"points += 1",
								"round_ended = true"
							]
						}
					]
				}
			],
			"next_round": [
				"reveal(all_hand)",
				{
					"if": "most('points') >= 4",
					"then": [
						"end_game(players_with_most('points'))"
					]
				},
				"offer('Next round')",
				"trigger('deal')"
			]
		},
		"effects": {},
		"conditions": {
			"other_side": "top(where(box, 'pair', one.pair))",
			"set_value": "number(top(zone), 'value')",
			"blocks_play": "count(zone) == count(choice) and set_value(zone) >= number(top(choice), 'value')",
			"beaten_by_play": "count(zone) == count(choice)",
			"blocks_add": "zone != to and count(zone) == count(to) + 1 and set_value(zone) >= number(card, 'value')",
			"beaten_by_add": "zone != to and count(zone) == count(to)",
			"in_play": "card.side == 'top' and card.dots <= size(players) - 2"
		},
		"condition_parameters": {
			"other_side": [
				"one"
			],
			"set_value": [
				"zone"
			],
			"blocks_play": [
				"zone"
			],
			"beaten_by_play": [
