			],
			"blocks_add": [
				"zone"
			],
			"beaten_by_add": [
				"zone"
			],
			"in_play": []
		},
		"condition_errors": [],
		"constants": {},
		"turn": [
			{
				"if": "out_set_turns > 0",
				"then": [
					"out_set_turns -= 1",
					{
						"if": "out_set_turns == 0",
						"then": [
							"move(set[first_out], discard)"
						]
					}
				]
			},
			"move(set, discard)",
			"offer(['Play a set', 'Add a card', 'Take a set', 'Rotate hand'])",
			{
				"if": "round_ended",
				"then": [
					"trigger('next_round')"
				],
				"else": [
					"end_turn()"
				]
			}
		],
