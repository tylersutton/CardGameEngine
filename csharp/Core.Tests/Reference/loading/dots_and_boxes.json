{
	"rules": {
		"title": "Dots and Boxes",
		"description": "You (Red) against a Blue bot, on a grid of 4 by 4 boxes. Take turns clicking the gap between two neighbouring dots to draw a line there. Draw the fourth side of a box and it's yours, and you go again. When every box is taken, whoever has more wins.",
		"how_to_play": [
			"# Goal",
			"Claim more of the 16 boxes than your opponent. You play Red.",
			"# The board",
			"- The faint lines between the dots are where lines can go; the squares they surround are boxes.",
			"# Your turn",
			"- Click a faint line between two dots to draw it in your color.",
			"- If your line closes the fourth side of a box, the box gets your color and you go again.",
			"# Tips",
			"- Don't draw the third side of a box: your opponent will take it.",
			"- When the game is over, the player with more boxes wins."
		],
		"zones": {
			"box": {
				"outline": false,
				"layout": "pile",
				"anchor": [
					-0.3,
					0.5
				],
				"cards": "res://decks/dots_and_boxes.csv"
			},
			"supply": {
				"per_player": true,
				"outline": false,
				"layout": "pile",
				"anchors": [
					[
						-0.3,
						0.5
					],
					[
						-0.3,
						0.5
					]
				]
			},
			"grid": {
				"board": {
					"shape": "square",
					"columns": 9.0,
					"rows": 9.0,
					"size": 60.0,
					"image": "boards/paper.svg",
					"paint": {
						"dot": "#1b1b1b dot",
						"gap_across": "#ddd2b8 hbar",
						"gap_down": "#ddd2b8 vbar"
					}
				},
				"outline": false,
				"anchor": [
					0.5,
					0.5
				]
			}
		},
		"actions": {
			"Draw a line": {
				"click": "grid",
				"when": "gap(clicked_zone) and count(clicked_zone) == 0",
				"steps": [
					"move(top(where(supply, 'kind', 'line')), clicked_zone)",
					"closed_now = zones_where(neighbors(clicked_zone, 'orthogonal'), 'closed')",
					{
						"for": "space",
						"in": "closed_now",
						"do": [
							"move(top(where(supply, 'kind', 'box')), space)",
							"score += 1"
						]
					},
					"another_go = size(closed_now) > 0"
				]
			}
		},
		"triggers": {
			"start": [
				{
					"for": "player",
					"in": "players",
					"do": [
						"move(where(box, 'seat', player), supply)"
					]
				},
				"player = one_of(players)"
			]
		},
		"effects": {},
		"conditions": {
			"dot": "space.column % 2 == 1 and space.row % 2 == 1",
			"box_space": "space.column % 2 == 0 and space.row % 2 == 0",
			"gap": "not dot(space) and not box_space(space)",
			"gap_across": "space.row % 2 == 1 and space.column % 2 == 0",
			"gap_down": "space.row % 2 == 0 and space.column % 2 == 1",
			"drawn": "count(space) > 0",
			"sides": "count(zones_where(neighbors(space, 'orthogonal'), 'drawn'))",
			"closed": "box_space(space) and count(space) == 0 and sides(space) == 4",
			"three_sided": "box_space(space) and sides(space) == 3"
		},
		"condition_parameters": {
			"dot": [
				"space"
			],
			"box_space": [
				"space"
			],
			"gap": [
				"space"
			],
			"gap_across": [
				"space"
			],
			"gap_down": [
				"space"
			],
			"drawn": [
				"space"
			],
			"sides": [
				"space"
			],
			"closed": [
				"space"
			],
			"three_sided": [
				"space"
			]
		},
		"condition_errors": [],
		"constants": {
			"boxes": 16
		},
		"turn": [
			"offer('Draw a line')",
			{
				"if": "score_1 + score_2 == boxes",
				"then": [
					"end_game(players_with_most('score'))"
				]
			},
			{
				"if": "not another_go",
				"then": [
					"end_turn()"
				]
			}
		],
		"variables": {
			"another_go": false
		},
		"players": 2,
		"seats": [
			[
				0.5,
				0.96
			],
			[
				0.5,
				0.04
			]
		],
		"player_names": [
			"Red",
			"Blue"
		],
		"player_variables": {
			"score": 0
		},
		"teams": [],
		"team_variables": {},
		"melds": {},
		"status": {
			"boxes": "'Red %d, Blue %d' % [score_1, score_2]"
		},
		"show_variables": [],
		"bot": {
			"players": [
				2.0
			],
			"prefer": "score - opponent_score - (0 if another_go else 0.6) * count(zones_where(grid, 'three_sided'))"
		},
		"card_face": {
			"shape": "shape",
			"size": "size",
			"background": "paint"
		},
		"unknown_keys": [],
		"error": ""
	},
