{
	"rules": {
		"title": "President",
		"description": "Four players, you against three bots. Play a single, pair, triple or four of a kind that beats or matches the last one (matching skips the next player), or pass. 2s are high and a single 2 beats anything, but you can't lead with a 2. Get rid of your cards first to become President.",
		"zones": {
			"deck": {
				"outline": false,
				"layout": "pile",
				"face": "down",
				"anchor": [
					0.7,
					0.5
				],
				"cards": "res://decks/standard_deck.csv",
				"columns": {
					"art": "'cards/' + card.rank + '_' + card.suit + '.png'",
					"order": "(card.value + 10) % 13 + 1"
				}
			},
			"hand": {
				"per_player": true,
				"layout": "fan",
				"face": "private",
				"width": 0.45,
				"anchor": [
					0.5,
					0.86
				]
			},
			"beaten": {
				"label": "Beaten",
				"layout": "pile",
				"anchor": [
					0.38,
					0.5
				]
			},
			"table": {
				"label": "To beat",
				"layout": "row",
				"width": 0.2,
				"anchor": [
					0.54,
					0.5
				]
			}
		},
		"actions": {
			"Play": {
				"choose": "matching(hand, 'can_beat')",
				"up_to": 4.0,
				"allow": "count(choice) > 0 and one_rank and (right_size or single_two)",
				"when": "count(hand) > 0",
				"steps": [
					"move(table, beaten)",
					"move(choice, table)",
					"set_size = count(choice)",
					"matched = number(top(choice), 'order') == top_order",
					"top_order = number(top(choice), 'order')",
					"last_played = player",
					"passes = 0",
					{
						"if": "count(hand) == 0",
						"then": [
							"trigger('finished')"
						]
					},
					{
						"if": "size(finish_order) == 3",
						"then": [
							"player = last_one_left",
							"trigger('finished')",
							"trigger('hand_over')"
						],
						"else": [
							{
								"if": "unbeatable",
								"then": [
									"trigger('clear')",
									{
										"if": "count(hand) == 0",
										"then": [
											"end_turn()"
										]
									}
								],
								"else": [
									"end_turn()",
									{
										"if": "matched",
										"then": [
											"trigger('pass')"
										]
									}
								]
							}
						]
					}
				]
			},
			"Pass": {
				"when": "set_size > 0",
				"steps": [
					"trigger('pass')"
				]
			},
			"Give 2 back": {
				"button": false,
				"choose": "hand",
				"pick": 2.0,
				"prefer": "sum(hand, 'order')",
				"steps": [
					"move(choice, hand[ranking[3]])"
				]
			},
			"Give 1 back": {
				"button": false,
				"choose": "hand",
				"prefer": "sum(hand, 'order')",
				"steps": [
					"move(choice, hand[ranking[2]])"
				]
			},
			"Next hand": {
				"human_only": true,
				"steps": [
					"trigger('deal')"
				]
			},
			"Sort by rank": {
				"any_time": true,
				"steps": [
					"sort(hand, ['order', 'suit'])"
				]
			}
		},
		"triggers": {
			"start": [
				"trigger('deal')"
			],
			"deal": [
				"move([all_hand, table, beaten], deck)",
				"shuffle(deck)",
				{
					"for": "player",
					"in": "players",
					"do": [
						"sort(hand, ['order', 'suit'])"
					]
				},
				"deal(deck, all_hand, 13)",
				"bring_back(players)",
				"reset(['finish_order', 'set_size', 'top_order', 'passes'])",
				{
					"if": "size(ranking) == 0",
					"then": [
						"player = owner(top(where(all_hand, 'name', '3♣')))"
					],
					"else": [
						"trigger('exchange')"
					]
				}
			],
			"exchange": [
				"move(highest(hand[ranking[3]], 'order'), hand[ranking[0]])",
				"move(highest(hand[ranking[3]], 'order'), hand[ranking[0]])",
				"move(highest(hand[ranking[2]], 'order'), hand[ranking[1]])",
				"player = ranking[3]",
				"ask('Give 2 back', ranking[0])",
				"ask('Give 1 back', ranking[1])"
			],
			"clear": [
				"reset(['set_size', 'top_order', 'passes'])"
			],
			"pass": [
				"passes += 1",
				"end_turn()",
				{
					"if": "round_over",
					"then": [
						"trigger('clear')"
					]
				}
			],
			"finished": [
				"knock_out(player)",
				"finish_order += [player]",
				"title = ['President', 'Vice President', 'Vice Scum', 'Scum'][size(finish_order) - 1]",
				"score += 4 - size(finish_order)"
			],
			"hand_over": [
				"reveal(all_hand)",
				"ranking = finish_order",
				"offer('Next hand')"
			]
		},
		"effects": {},
		"conditions": {
			"is_two": "card.data.rank == '2'",
			"can_beat": "(is_two and (set_size > 0 or only_twos_left)) or (not is_two and number(card, 'order') >= top_order and count(where(hand, 'rank', card.data.rank)) >= max(set_size, 1))",
			"only_twos_left": "count(where(all_hand, 'rank', '2')) == count(all_hand)",
			"one_rank": "size(groups(choice, 'rank')) == 1",
			"right_size": "set_size == 0 or count(choice) == set_size",
			"single_two": "count(choice) == 1 and text(top(choice), 'rank') == '2'",
			"unbeatable": "top_order == 13",
			"round_over": "set_size > 0 and passes >= count(tops(all_hand)) - int(count(hand[last_played]) > 0)",
			"last_one_left": "owner(top(tops(all_hand)))"
		},
		"condition_parameters": {
			"is_two": [],
			"can_beat": [],
			"only_twos_left": [],
			"one_rank": [],
			"right_size": [],
			"single_two": [],
			"unbeatable": [],
			"round_over": [],
			"last_one_left": []
		},
		"condition_errors": [],
		"constants": {},
		"turn": [
			{
				"if": "set_size == 0 and count(matching(hand, 'can_beat')) == 0",
				"then": [
					"end_turn()"
				],
				"else": [
					"offer(['Play', 'Pass'])"
				]
			}
		],
