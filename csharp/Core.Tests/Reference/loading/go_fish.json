	"rules": {
		"title": "Go Fish",
		"description": "2 players. Describe your game here.",
		"zones": {
			"deck": {
				"label": "Deck",
				"layout": "pile",
				"face": "down",
				"anchor": [
					0.5,
					0.5
				],
				"cards": "res://decks/standard_deck.csv"
			},
			"hand": {
				"per_player": true,
				"layout": "fan",
				"face": "private",
				"anchor": [
					0.5,
					0.84
				]
			},
			"books": {
				"layout": "pile",
				"anchor": [
					0.8,
					0.84
				],
				"per_player": true
			}
		},
		"actions": {
			"Sort hand": {
				"steps": [
					"sort(hand, ['name'])"
				]
			},
			"Ask": {
				"steps": [
					"asked_rank = choose(hand, 'Click the card whose rank you want').rank",
					"got = where(opponent_hand, 'rank', asked_rank)",
					{
						"if": "count(got) > 0",
						"then": [
							"move(got, hand)"
						],
						"else": [
							"offer('Go Fish')",
							{
								"if": "got.rank != asked_rank",
								"then": [
									"go_again = false"
								]
							}
						]
					}
				]
			},
			"Go Fish": {
				"steps": [
					"got = card"
				],
				"drag": {
					"from": "deck",
					"to": "hand"
				},
				"click": true
			}
		},
		"triggers": {
			"start": [
				"sort(hand_1, ['value','suit'])",
				"sort(hand_2, ['value','suit'])",
				"shuffle(deck)",
				"deal(deck, all_hand, starting_hand_size)"
			]
		},
		"effects": {},
		"conditions": {},
		"condition_parameters": {},
		"condition_errors": [],
		"constants": {},
		"turn": [
			{
				"while": "go_again",
				"do": [
					"offer('Ask')",
					{
						"for": "group",
						"in": "groups(hand, 'rank')",
						"do": [
							{
								"if": "count(where(hand, 'rank', top(group).rank)) == 4",
								"then": [
									"move(where(hand, 'rank', top(group).rank), books)"
								]
							}
						]
					}
				]
			},
			"go_again = true",
			"end_turn()"
		],
		"variables": {
			"asked_rank": 0,
			"starting_hand_size": 7
