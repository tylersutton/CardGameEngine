		"turn": [
			{
				"if": "player == last_chance_caller",
				"then": [
					"trigger('show_points')",
					"end_game(player if my_points >= most('my_points') else players_with_most('my_points'))"
				]
			},
			{
				"if": "count(deck) == 0",
				"then": [
					"end_game()"
				]
			},
			"offer(['Draw two', 'Take a discard'])",
			"ending = offer_until('Play duo', ['End turn', 'Stop', 'Last chance'])",
			{
				"if": "extra_turn and ending == 'End turn'",
				"then": [
					"extra_turn = false"
				],
				"else": [
					"extra_turn = false",
					"end_turn()"
				]
			}
		],
