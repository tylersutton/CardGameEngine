		"actions": {
			"Pair to 13": {
				"drag": {
					"from": [
						"pyramid",
						"waste"
					],
					"to": [
						"pyramid",
						"waste"
					]
				},
				"when": "free and count(to) > 0 and not covered(to) and makes_13",
				"steps": [
					"move(card, removed)",
					"move(top(to), removed)",
					"trigger('check_win')"
				]
			},
			"Turn a card": {
				"click": "stock",
				"steps": [
					"trigger('turn_card')"
				]
			},
			"Remove a King": {
				"click": [
					"waste",
					"pyramid"
				],
				"when": "number(card, 'value') == 13 and free",
				"steps": [
					"move(card, removed)",
					"trigger('check_win')"
				]
			}
		},
		"triggers": {
			"start": [
				"shuffle(stock)",
				{
					"for": "spot",
					"in": "pyramid",
					"do": [
						"draw(stock, spot)"
					]
				}
			],
			"turn_card": [
				{
					"if": "count(stock) > 0",
					"then": [
						"draw(stock, waste)"
					],
					"else": [
						{
							"if": "passes < 3",
							"then": [
								"draw(waste, stock, count(waste))",
								"passes += 1"
							]
						}
					]
				}
			],
			"check_win": [
				{
					"if": "count(pyramid) == 0",
					"then": [
						"result = 'You win!'"
					]
				}
			]
		},
		"effects": {},
		"conditions": {
			"free": "not covered(card)",
			"makes_13": "number(card, 'value') + number(top(to), 'value') == 13"
		},
