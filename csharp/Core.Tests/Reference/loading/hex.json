{
	"rules": {
		"title": "Hex",
		"description": "You play Red against a Blue bot. Take turns placing a stone on any empty cell: click it, or drag a stone there from your pile. Red wins by joining the top and bottom edges with a chain of red stones, Blue by joining the left and right edges. Someone always wins.",
		"zones": {
			"cell": {
				"board": {
					"shape": "hex",
					"columns": 9.0,
					"rows": 9.0,
					"size": 46.0,
					"paint": {
						"top_edge": "#a8473f",
						"bottom_edge": "#a8473f",
						"left_edge": "#3f62a8",
						"right_edge": "#3f62a8"
					}
				},
				"anchor": [
					0.5,
					0.5
				]
			},
			"box": {
				"layout": "pile",
				"outline": false,
				"anchor": [
					-0.3,
					0.5
				],
				"cards": "res://decks/hex_stones.csv"
			},
			"stones": {
				"per_player": true,
				"layout": "pile",
				"outline": false,
				"anchors": [
					[
						0.35,
						0.9
					],
					[
						0.1,
						0.35
					]
				]
			}
		},
		"actions": {
			"Place": {
				"click": "cell",
				"when": "count(clicked_zone) == 0",
				"steps": [
					"draw(stones, clicked_zone)"
				]
			},
			"Place by dragging": {
				"drag": {
					"from": "stones",
					"to": "cell"
				},
				"when": "count(to) == 0"
			}
		},
		"triggers": {
			"start": [
				"move(where(box, 'name', 'Red'), stones[1])",
				"move(where(box, 'name', 'Blue'), stones[2])"
			]
		},
		"effects": {},
		"conditions": {
			"my_color": "'Red' if player == 1 else 'Blue'",
			"mine": "text(top(space), 'name') == my_color",
			"top_edge": "space.row == 1",
			"bottom_edge": "space.row == 9",
			"left_edge": "space.column == 1",
			"right_edge": "space.column == 9",
			"won": "connected(zones_where(cell, 'top_edge'), zones_where(cell, 'bottom_edge'), 'mine') if player == 1 else connected(zones_where(cell, 'left_edge'), zones_where(cell, 'right_edge'), 'mine')"
		},
		"condition_parameters": {
			"my_color": [],
			"mine": [
				"space"
			],
			"top_edge": [
				"space"
			],
			"bottom_edge": [
				"space"
			],
			"left_edge": [
				"space"
			],
			"right_edge": [
				"space"
			],
			"won": []
		},
		"condition_errors": [],
		"constants": {},
		"turn": [
			"offer(['Place', 'Place by dragging'])",
			{
				"if": "won",
				"then": [
					"end_game(player)"
				]
			},
			"end_turn()"
		],
		"variables": {},
		"players": 2,
		"seats": [
			[
				0.5,
				0.94
			],
			[
				0.12,
				0.5
			]
		],
		"player_names": [
			"Red",
			"Blue"
		],
		"player_variables": {},
		"teams": [],
		"team_variables": {},
		"melds": {},
		"status": {
			"goal": "'Red joins the red edges; Blue joins the blue edges'"
		},
