		"melds": {},
		"status": {
			"your points this hand": "sum(won[min(viewer(), 4)], 'points')",
			"passing": "['no pass', 'left', 'across', 'right'][int(pass_to)]"
		},
		"show_variables": [
			"hearts_broken",
			"score_1",
			"score_2",
			"score_3",
			"score_4"
		],
		"bot": {
