{
	"rules": {
		"title": "Hearts",
		"description": "Four players, you against three bots. Pass three cards (left, right, across, then keep), follow suit, and avoid hearts and the queen of spades. Take every point card to shoot the moon. The game ends when someone reaches 100; lowest score wins.",
		"zones": {
			"deck": {
				"outline": false,
				"layout": "pile",
				"face": "down",
				"anchor": [
					0.5,
					0.5
				],
				"cards": "res://decks/standard_deck.csv",
				"columns": {
					"value": "14 if card.rank == 'A' else card.value",
					"points": "13 if card.name == 'Q♠' else int(card.suit == 'Hearts')"
				}
			},
			"hand": {
				"per_player": true,
				"layout": "fan",
				"face": "private",
				"width": 0.45,
				"anchor": [
					0.5,
					0.86
				]
			},
			"played": {
				"per_player": true,
				"layout": "pile",
				"anchor": [
					0.5,
					0.62
				]
			},
			"won": {
				"label": "Tricks",
				"per_player": true,
				"layout": "pile",
				"face": "down",
				"anchor": [
					0.787,
					0.86
				]
			}
		},
		"actions": {
			"Play a card": {
				"drag": {
					"from": "hand",
					"to": "played"
				},
				"when": "follows_suit(card, hand, lead) and hearts_allowed and two_of_clubs_leads",
				"steps": [
					{
						"if": "lead == ''",
						"then": [
							"lead = card.data.suit"
						]
					},
					{
						"if": "card.data.suit == 'Hearts'",
						"then": [
							"hearts_broken = true"
						]
					}
				]
			},
			"Collect trick": {
				"human_only": true,
				"steps": [
					"move(all_played, won)",
					"lead = ''",
					"tricks += 1"
				]
			},
			"Next hand": {
				"human_only": true,
				"steps": [
					"trigger('deal')"
				]
			}
		},
		"triggers": {
			"start": [
				{
					"for": "player",
					"in": "players",
					"do": [
						"sort(hand, ['suit', 'value'])"
					]
				},
				"trigger('deal')"
			],
			"deal": [
				"hand_number += 1",
				"pass_to = [1, 3, 2, 0][int(hand_number - 1) % 4]",
				"move([all_hand, all_played, all_won], deck)",
				"shuffle(deck)",
				"deal(deck, all_hand, 13)",
				"reset(['tricks', 'lead', 'hearts_broken'])",
				"player = 1",
				{
					"if": "pass_to == 0",
					"then": [
						"trigger('first_lead')"
					],
					"else": [
						"trigger('exchange')"
					]
				}
			],
			"exchange": [
				{
					"for": "player",
					"in": "players",
					"do": [
						"passing = choose_exactly(hand, 3, 'Pass three cards %s' % ['', 'left', 'across', 'right'][int(pass_to)])",
						"move(passing, played)",
						"flip(passing)"
					]
				},
				{
					"for": "player",
					"in": "players",
					"do": [
						"move(played, hand[next_player(pass_to)])"
					]
				},
				"trigger('first_lead')"
			],
			"first_lead": [
				"player = owner(top(where(all_hand, 'name', '2♣')))"
			],
			"score_hand": [
				"moon_shooters = players_where('shot_the_moon')",
				{
					"for": "player",
					"in": "players",
					"do": [
						{
							"if": "size(moon_shooters) == 0",
							"then": [
								"score += sum(won, 'points')"
							],
							"else": [
								{
									"if": "player not in moon_shooters",
									"then": [
										"score += 26"
									]
								}
							]
						}
					]
				},
				{
					"if": "most('score') >= 100",
					"then": [
						"end_game(players_with_least('score'))"
					]
				}
			]
		},
		"effects": {},
		"conditions": {
			"hearts_allowed": "lead != '' or card.data.suit != 'Hearts' or hearts_broken or count(where(hand, 'suit', 'Hearts')) == count(hand)",
			"two_of_clubs_leads": "tricks > 0 or lead != '' or card.data.name == '2♣'",
			"shot_the_moon": "sum(won, 'points') == 26",
			"played_face_up": "sum(played, 'value') - sum(face_down(played), 'value')"
		},
		"condition_parameters": {
			"hearts_allowed": [],
			"two_of_clubs_leads": [],
			"shot_the_moon": [],
			"played_face_up": []
		},
		"condition_errors": [],
		"constants": {},
		"turn": [
			"offer('Play a card')",
			{
				"if": "count(all_played) < 4",
				"then": [
					"end_turn()"
				],
				"else": [
					"player = owner(trick_winner(all_played, lead))",
					"offer('Collect trick')",
					{
						"if": "count(all_hand) == 0",
						"then": [
							"trigger('score_hand')",
							"offer('Next hand')"
						]
					}
				]
			}
		],
		"variables": {
			"hand_number": 0,
			"pass_to": 1,
			"lead": "",
			"hearts_broken": false,
			"tricks": 0
		},
		"players": 4,
