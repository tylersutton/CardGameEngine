				"anchor": [
					0.4,
					0.42
				]
			},
			"pile": {
				"label": "Pile",
				"layout": "pile",
				"anchor": [
					0.55,
					0.42
				]
			},
			"out": {
				"label": "Out",
				"layout": "pile",
				"anchor": [
					0.85,
					0.86
				]
			},
			"peek": {
				"outline": false,
				"per_player": true,
				"layout": "row",
				"face": "private",
				"width": 0.2,
				"anchor": [
					0.5,
					0.64
				]
			},
			"hand": {
				"per_player": true,
				"layout": "fan",
				"face": "private",
				"width": 0.45,
				"anchor": [
					0.5,
					0.86
				]
			}
		},
		"actions": {
			"Play an action": {
				"drag": {
					"from": "hand",
					"to": "pile"
				},
				"when": "card.data.kind == 'action' and pending == ''",
				"steps": [
					"pending = card.data.name",
					"actor = player",
					"noped = false",
					"target = next_player()",
					"ask_others('Nope?', 'resolve')"
				]
			},
			"Draw": {
				"drag": {
					"from": "deck",
					"to": "hand"
				},
				"when": "pending == ''",
				"steps": [
					{
						"if": "card.data.kind == 'bomb'",
						"then": [
							{
								"if": "count(matching(hand, 'is_defuse')) > 0",
								"then": [
									"move(top(matching(hand, 'is_defuse')), pile)",
									"move(card, deck)",
									"shuffle(deck)"
								],
								"else": [
									"trigger('knocked_out')"
								]
							}
						]
					},
					"end_turn()"
				]
			},
			"Nope?": {
				"button": false,
				"when": "player in players_left() and has_nope",
				"choose": "['Nope!', 'Let it happen']",
				"prefer": "10 * int((noped and target == player) or (not noped and actor == player)) + count(hand)",
				"steps": [
					{
						"if": "choice == 'Nope!'",
						"then": [
							"move(top(where(hand, 'name', 'Nope')), pile)",
							"noped = not noped",
							"ask_others('Nope?', 'resolve')"
						]
					}
				]
			},
			"Give a card": {
				"button": false,
				"choose": "hand",
				"prefer": "20 * count(matching(hand, 'is_defuse')) + 3 * count(where(hand, 'name', 'Nope'))",
				"steps": [
					"move(choice, hand[actor])"
				]
			},
			"Sort hand": {
				"any_time": true,
				"steps": [
					"sort(hand, ['kind', 'name'])"
				]
			}
		},
		"triggers": {
			"start": [
				{
					"for": "player",
					"in": "players",
					"do": [
						"sort(hand, ['kind', 'name'])"
					]
				},
				"move(where(box, 'kind', 'action'), deck)",
				"move(where(box, 'kind', 'nope'), deck)",
				"shuffle(deck)",
				{
					"for": "player",
					"in": "players",
					"do": [
						"move(top(where(box, 'kind', 'defuse')), hand)"
					]
				},
				"deal(deck, all_hand, 4)",
				"move(where(box, 'kind', 'defuse'), deck)",
				"move(first(where(box, 'kind', 'bomb'), size(players) - 1), deck)",
				"shuffle(deck)",
				"player = one_of(players)"
			],
			"resolve": [
				{
					"if": "not noped",
					"then": [
						"trigger(pending)"
					]
				},
				"pending = ''"
			],
			"Skip": [
				"end_turn()"
			],
			"Shuffle": [
				"shuffle(deck)"
			],
			"Peek": [
				"move(last(deck, 3), peek)",
				"choose(['Done'], 'Peek: the next three cards, top on the right')",
				"move(all(peek), deck)"
			],
			"Steal": [
				{
					"if": "target != 0",
					"then": [
						"ask('Give a card', target)"
					]
				}
			],
			"knocked_out": [
				"knock_out(player)",
				"move(hand, out)",
				{
					"if": "size(players_left()) == 1",
					"then": [
						"end_game(players_left())"
					]
				}
			]
		},
		"effects": {},
		"conditions": {
			"is_defuse": "card.data.kind == 'defuse'",
			"has_nope": "count(where(hand, 'name', 'Nope')) > 0"
		},
