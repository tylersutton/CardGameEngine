{
	"rules": {
		"title": "Goofspiel",
		"description": "Two or three players, you against bots, all bidding at once. Each round a diamond is turned up as the prize; everyone secretly bids a card from their suit, then the bids are revealed. The highest bid takes the prize (a tie leaves it for the next round). Most prize points after 13 rounds wins.",
		"zones": {
			"box": {
				"outline": false,
				"layout": "pile",
				"face": "down",
				"anchor": [
					-0.3,
					0.5
				],
