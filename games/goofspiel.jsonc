{
	"title": "Goofspiel",
	"description": "Two or three players, you against bots, all bidding at once. Each round a diamond is turned up as the prize; everyone secretly bids a card from their suit, then the bids are revealed. The highest bid takes the prize (a tie leaves it for the next round). Most prize points after 13 rounds wins.",
	"players": [
		3,
		2
	],
	"player_names": [
		"You",
		"West",
		"East"
	],
	"seats": [
		[
			0.16,
			0.86
		],
		[
			0.09,
			0.18
		],
		[
			0.91,
			0.18
		]
	],
	"zones": {
		"box": {
			"outline": false,
			"layout": "pile",
			"face": "down",
			"anchor": [
				-0.3,
				0.5
			],
			"cards": "res://decks/standard_deck.csv",
			"columns": {
				"art": "'cards/' + card.rank + '_' + card.suit + '.png'"
			}
		},
		"prizes": {
			"label": "Prizes",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.38,
				0.32
			]
		},
		"prize": {
			"label": "Prize",
			"layout": "row",
			"width": 0.2,
			"anchor": [
				0.53,
				0.32
			]
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"width": 0.45,
			"anchors": [
				[
					0.5,
					0.86
				],
				[
					0.09,
					0.5
				],
				[
					0.91,
					0.5
				]
			],
			"rotations": [
				0,
				90,
				270
			]
		},
		"bid": {
			"label": "Bid",
			"per_player": true,
			"layout": "pile",
			"face": "down",
			"anchors": [
				[
					0.5,
					0.62
				],
				[
					0.3,
					0.5
				],
				[
					0.7,
					0.5
				]
			]
		},
		"won": {
			"label": "Won",
			"per_player": true,
			"layout": "pile",
			"anchors": [
				[
					0.84,
					0.86
				],
				[
					0.25,
					0.16
				],
				[
					0.75,
					0.16
				]
			]
		}
	},
	"variables": {
		"stake": 0,
		"high": 0
	},
	"show_variables": [
		"stake"
	],
	"status": {
		"your points": "sum(won[viewer()], 'value')",
		"most points": "most('prize_points')",
		"prize worth": "stake"
	},
	"bot": {
		"players": [
			2,
			3
		],
		"prefer": "sum(won, 'value')"
	},
	"conditions": {
		"prize_points": "sum(won, 'value')",
		"high_bids": "where(all_bid, 'value', high)"
	},
	"actions": {
		"Bid": {
			"button": false,
			"choose": "hand",
			"prefer": "-abs(sum(bid, 'value') - stake - player + 1)",
			"steps": [
				"move(choice, bid)"
			]
		},
		"Next round": {
			"human_only": true,
			"steps": []
		},
		"Sort hand": {
			"any_time": true,
			"steps": [
				"sort(hand, ['value'])"
			]
		}
	},
	"triggers": {
		"start": [
			{
				"for": "player",
				"in": "players",
				"do": [
					"sort(hand, ['value'])",
					"move(where(box, 'suit', ['Spades', 'Hearts', 'Clubs'][player - 1]), hand)"
				]
			},
			"move(where(box, 'suit', 'Diamonds'), prizes)",
			"shuffle(prizes)",
			"trigger('round')"
		],
		"round": [
			"move(top(prizes), prize)",
			"stake = sum(prize, 'value')",
			"ask_all('Bid', 'reveal')"
		],
		"reveal": [
			"flip(all_bid)",
			"high = number(highest(all_bid, 'value'), 'value')",
			{
				"if": "count(high_bids) == 1",
				"then": [
					"move(prize, won[owner(top(high_bids))])"
				]
			},
			"offer('Next round')",
			"move(all_bid, box)",
			{
				"if": "count(prizes) > 0",
				"then": [
					"trigger('round')"
				],
				"else": [
					"trigger('game_over')"
				]
			}
		],
		"game_over": [
			"move(prize, box)",
			"end_game(players_with_most('prize_points'))"
		]
	},
	"card_face": {
		"corner": "name",
		"title": "name",
		"body": [
			"suit"
		],
		"color": "color",
		"image": "art",
		"card_back": "card_back.svg"
	}
}