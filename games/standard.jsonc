{
	"title": "Free Play",
	"description": "A standard deck with no rules: draw, play, discard, and sort.",
	"how_to_play": [
		"# A sandbox",
		"A standard deck with no rules: use it to try out ideas.",
		"- Click the deck (or press Draw) to draw a card.",
		"- Drag cards anywhere you like: to your hand, to the table, back to the deck.",
		"- Press Shuffle to shuffle the deck, and the sort buttons to sort your hand."
	],
	"zones": {
		"deck": {
			"label": "Deck",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.42,
				0.5
			],
			"cards": "res://decks/standard_deck.csv",
			"columns": {
				"art": "'cards/' + card.rank + '_' + card.suit + '.png'"
			}
		},
		"discard": {
			"label": "Discard",
			"layout": "pile",
			"anchor": [
				0.58,
				0.5
			]
		},
		"table": {
			"label": "Table",
			"anchor": [
				0.5,
				0.18
			]
		},
		"hand": {
			"label": "Hand",
			"layout": "fan",
			"anchor": [
				0.5,
				0.82
			]
		}
	},
	"actions": {
		"Draw from the deck": {
			"click": "deck",
			"steps": [
				"draw(deck, hand)"
			]
		},
		"Shuffle": [
			"shuffle(deck)"
		],
		"Draw": [
			"draw(deck, hand)"
		],
		"Sort by suit": {
			"any_time": true,
			"steps": [
				"sort(hand, ['suit', 'value'])"
			]
		},
		"Sort by value": {
			"any_time": true,
			"steps": [
				"sort(hand, ['value', 'suit'])"
			]
		}
	},
	"triggers": {
		"start": [
			"sort(hand, ['value', 'suit'])",
			"shuffle(deck)",
			"draw(deck, hand, 7)"
		],
		"deck_empty": [
			"move(all(discard), deck)",
			"shuffle(deck)"
		]
	},
	"card_face": {
		"corner": "name",
		"title": "name",
		"body": [
			"suit"
		],
		"color": "color",
		"image": "art",
		"card_back": "card_back.svg"
	}
}