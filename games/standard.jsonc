{
	"title": "Free Play",
	"description": "A standard deck with no rules: draw, play, discard, and sort.",
	"zones": {
		"deck": {
			"label": "Deck",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.42,
				0.5
			],
			"cards": "res://decks/standard_deck.csv",
			"on_click": [
				"draw(deck, hand)"
			]
		},
		"discard": {
			"label": "Discard",
			"layout": "pile",
			"anchor": [
				0.58,
				0.5
			]
		},
		"table": {
			"label": "Table",
			"anchor": [
				0.5,
				0.18
			]
		},
		"hand": {
			"label": "Hand",
			"layout": "fan",
			"anchor": [
				0.5,
				0.82
			]
		}
	},
	"actions": {
		"Shuffle": [
			"shuffle(deck)"
		],
		"Draw": [
			"draw(deck, hand)"
		],
		"Sort by suit": [
			"sort(hand, ['suit', 'value'])"
		],
		"Sort by value": [
			"sort(hand, ['value', 'suit'])"
		]
	},
	"triggers": {
		"start": [
			"sort(hand, ['value', 'suit'])",
			"shuffle(deck)",
			"draw(deck, hand, 7)"
		],
		"deck_empty": [
			"move(all(discard), deck)",
			"shuffle(deck)"
		]
	},
	"card_face": {
		"corner": "name",
		"title": "name",
		"body": [
			"suit"
		],
		"color": "color"
	}
}