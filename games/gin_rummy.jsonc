{
	"title": "Gin Rummy",
	"description": "Two players, you against a bot. Knock with 10 or less deadwood; first to 100 wins the match.",
	"how_to_play": [
		"# Goal",
		"Form melds and get down to 10 points of deadwood or less, then knock. First to 100 points wins the match.",
		"# Melds and deadwood",
		"- A meld is three or more cards of the same rank, or three or more in a row of the same suit.",
		"- Deadwood is everything not in a meld. Aces count 1, face cards 10, others their number.",
		"# Your turn",
		"- Draw: click the stock, or take the discard (click the top discard). At the start of a hand, the first player may take the upcard or press Pass.",
		"- Then discard: drag a card from your hand to the discard pile.",
		"- Or knock instead of discarding: drag a card to Knock (or press Knock) when what's left has 10 deadwood or less. Big Gin: press it when all 11 cards are melded.",
		"# Scoring",
		"- The knocker scores the difference in deadwood. Gin (no deadwood) scores 25 extra; Big Gin 31.",
		"- If the other player has as little deadwood or less (an undercut), they score 25 plus the difference instead.",
		"- Press Next hand to deal again."
	],
	"players": 2,
	"seats": [
		[
			0.18,
			0.83
		],
		[
			0.18,
			0.16
		]
	],
	"zones": {
		"stock": {
			"label": "Stock",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.08,
				0.5
			],
			"cards": "res://decks/standard_deck.csv",
			"columns": {
				"art": "'cards/' + card.rank + '_' + card.suit + '.png'",
				"points": "min(card.value, 10)"
			}
		},
		"discard": {
			"label": "Discard",
			"layout": "pile",
			"anchor": [
				0.19,
				0.5
			]
		},
		"knock": {
			"label": "Knock",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.3,
				0.5
			]
		},
		"table": {
			"per_player": true,
			"layout": "melds",
			"anchors": [
				[
					0.68,
					0.63
				],
				[
					0.68,
					0.37
				]
			]
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"anchors": [
				[
					0.5,
					0.83
				],
				[
					0.5,
					0.16
				]
			]
		}
	},
	"variables": {
		"stage": "upcard",
		"passes": 0,
		"result": "",
		"knocker_deadwood": 0,
		"defender_deadwood": 0,
		"dealer": 2,
		"winner": null
	},
	"player_variables": {
		"score": 0,
		"hands_won": 0
	},
	"bot": {
		"players": [
			2
		],
		"prefer": "score - opponent_score - sum(deadwood(hand), 'points')"
	},
	"status": {
		"scores": "'%s %d, %s %d' % [name_of(1), score_1, name_of(2), score_2]",
		"your deadwood": "sum(deadwood(hand[min(viewer(), 2)]), 'points')"
	},
	"melds": {
		"types": [
			{
				"same": "rank",
				"min": 3
			},
			{
				"same": "suit",
				"sequence": "value",
				"min": 3
			}
		],
		"points": "points"
	},
	"actions": {
		"Draw from the stock": {
			"drag": {
				"from": "stock",
				"to": "hand"
			},
			"click": true,
			"steps": [
				"stage = 'draw'"
			]
		},
		"Take the discard": {
			"drag": {
				"from": "discard",
				"to": "hand"
			},
			"click": true,
			"steps": [
				"stage = 'draw'"
			]
		},
		"Discard": {
			"drag": {
				"from": "hand",
				"to": "discard"
			}
		},
		"Knock": {
			"drag": {
				"from": "hand",
				"to": "knock"
			},
			"button": true,
			"when": "sum(deadwood(without(hand, card)), 'points') <= 10",
			"steps": [
				"knocker_deadwood = sum(deadwood(hand), 'points')",
				{
					"if": "knocker_deadwood == 0",
					"then": [
						"defender_deadwood = sum(deadwood(opponent_hand), 'points')",
						"result = 'gin'",
						"score += 25 + defender_deadwood",
						"hands_won += 1"
					],
					"else": [
						"move(layoff(opponent_hand, melds(hand)), table)",
						"defender_deadwood = sum(deadwood(opponent_hand), 'points')",
						{
							"if": "defender_deadwood <= knocker_deadwood",
							"then": [
								"result = 'undercut'",
								"opponent_score += 25 + knocker_deadwood - defender_deadwood",
								"opponent_hands_won += 1"
							],
							"else": [
								"result = 'knock'",
								"score += defender_deadwood - knocker_deadwood",
								"hands_won += 1"
							]
						}
					]
				},
				"move(hand, table)",
				"move(opponent_hand, opponent_table)",
				"trigger('hand_over')"
			]
		},
		"Pass": {
			"steps": [
				"passes += 1",
				{
					"if": "passes == 2",
					"then": [
						"stage = 'stock_only'"
					]
				}
			]
		},
		"Big Gin": {
			"when": "count(deadwood(hand)) == 0",
			"steps": [
				"defender_deadwood = sum(deadwood(opponent_hand), 'points')",
				"result = 'big gin'",
				"score += 31 + defender_deadwood",
				"hands_won += 1",
				"move(hand, table)",
				"move(opponent_hand, opponent_table)",
				"trigger('hand_over')"
			]
		},
		"Next hand": {
			"human_only": true,
			"steps": [
				"dealer = 3 - dealer",
				"trigger('deal')"
			]
		},
		"Sort by suit": {
			"any_time": true,
			"steps": [
				"sort(hand, ['suit', 'value'])"
			]
		},
		"Sort by rank": {
			"any_time": true,
			"steps": [
				"sort(hand, ['value', 'suit'])"
			]
		}
	},
	"turn": [
		{
			"if": "stage == 'upcard'",
			"then": [
				"offer(['Take the discard', 'Pass'])"
			],
			"else": [
				{
					"if": "stage == 'stock_only'",
					"then": [
						"offer('Draw from the stock')"
					],
					"else": [
						"offer(['Draw from the stock', 'Take the discard'])"
					]
				}
			]
		},
		{
			"if": "count(hand) == 11",
			"then": [
				"ending = offer(['Discard', 'Knock', 'Big Gin'])",
				{
					"if": "ending == 'Discard' and count(stock) > 2",
					"then": [
						"end_turn()"
					],
					"else": [
						{
							"if": "ending == 'Discard'",
							"then": [
								"result = 'void: stock ran out'"
							]
						},
						"offer('Next hand')"
					]
				}
			],
			"else": [
				"end_turn()"
			]
		}
	],
	"triggers": {
		"start": [
			"dealer = one_of(players)",
			"trigger('deal')"
		],
		"deal": [
			"move([hand_1, hand_2, table_1, table_2, discard, knock], stock)",
			"shuffle(stock)",
			"sort(hand_1, ['value', 'suit'])",
			"sort(hand_2, ['value', 'suit'])",
			"player = 3 - dealer",
			"deal(stock, [hand, opponent_hand], 10)",
			"move(top(stock), discard)",
			"reset(['stage', 'passes', 'result', 'knocker_deadwood', 'defender_deadwood'])"
		],
		"hand_over": [
			{
				"if": "most('score') >= 100",
				"then": [
					"player = players_with_most('score')[0]",
					"winner = player",
					"score += 100 + 25 * hands_won",
					"opponent_score += 25 * opponent_hands_won",
					{
						"if": "opponent_hands_won == 0",
						"then": [
							"score = score * 2",
							"result += ', shutout'"
						]
					},
					"end_game(player)"
				]
			}
		]
	},
	"card_face": {
		"corner": "name",
		"title": "name",
		"body": [
			"suit"
		],
		"color": "color",
		"image": "art",
		"card_back": "card_back.svg"
	}
}