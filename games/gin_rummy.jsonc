{
	"title": "Gin Rummy",
	"description": "Two players, you against a bot. Knock with 10 or less deadwood; first to 100 wins the match.",
	"players": 2,
	"seats": [
		[
			0.1,
			0.72
		],
		[
			0.1,
			0.28
		]
	],
	"zones": {
		"stock": {
			"label": "Stock",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.08,
				0.5
			],
			"cards": "res://decks/standard_deck.csv",
			"columns": {
				"points": "min(card.value, 10)"
			},
			"on_click": [
				"try_move(top(stock), hand)"
			]
		},
		"discard": {
			"label": "Discard",
			"layout": "pile",
			"anchor": [
				0.19,
				0.5
			],
			"on_click": [
				"try_move(top(discard), hand)"
			]
		},
		"knock": {
			"label": "Knock",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.3,
				0.5
			]
		},
		"table": {
			"per_player": true,
			"layout": "melds",
			"anchors": [
				[
					0.68,
					0.63
				],
				[
					0.68,
					0.37
				]
			]
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"anchors": [
				[
					0.5,
					0.83
				],
				[
					0.5,
					0.16
				]
			]
		}
	},
	"variables": {
		"phase": "upcard",
		"taken": null,
		"passes": 0,
		"result": "",
		"knocker_deadwood": 0,
		"defender_deadwood": 0,
		"dealer": 2,
		"winner": null
	},
	"player_variables": {
		"score": 0,
		"hands_won": 0
	},
	"bot": {
		"players": [
			2
		],
		"prefer": "score - opponent_score - sum(deadwood(hand), 'points')"
	},
	"status": {
		"your deadwood": "sum(deadwood(zone('hand', min(viewer(), 2))), 'points')"
	},
	"melds": {
		"types": [
			{
				"same": "rank",
				"min": 3
			},
			{
				"same": "suit",
				"sequence": "value",
				"min": 3
			}
		],
		"points": "points"
	},
	"moves": [
		{
			"from": "stock",
			"to": "hand",
			"phase": [
				"draw",
				"stock_only"
			],
			"then": [
				"phase = 'discard'",
				"taken = null"
			]
		},
		{
			"from": "discard",
			"to": "hand",
			"phase": [
				"draw",
				"upcard"
			],
			"then": [
				"phase = 'discard'",
				"taken = card"
			]
		},
		{
			"from": "hand",
			"to": "discard",
			"phase": "discard",
			"when": "card != taken",
			"then": [
				{
					"if": "count(stock) <= 2",
					"then": [
						"phase = 'over'",
						"result = 'void: stock ran out'"
					],
					"else": [
						"phase = 'draw'",
						"end_turn()"
					]
				}
			]
		},
		{
			"from": "hand",
			"to": "knock",
			"phase": "discard",
			"when": "card != taken and sum(deadwood(without(hand, card)), 'points') <= 10",
			"then": [
				"phase = 'over'",
				"knocker_deadwood = sum(deadwood(hand), 'points')",
				{
					"if": "knocker_deadwood == 0",
					"then": [
						"defender_deadwood = sum(deadwood(opponent_hand), 'points')",
						"result = 'gin'",
						"score += 25 + defender_deadwood",
						"hands_won += 1"
					],
					"else": [
						"move(layoff(opponent_hand, melds(hand)), table)",
						"defender_deadwood = sum(deadwood(opponent_hand), 'points')",
						{
							"if": "defender_deadwood <= knocker_deadwood",
							"then": [
								"result = 'undercut'",
								"opponent_score += 25 + knocker_deadwood - defender_deadwood",
								"opponent_hands_won += 1"
							],
							"else": [
								"result = 'knock'",
								"score += defender_deadwood - knocker_deadwood",
								"hands_won += 1"
							]
						}
					]
				},
				"move(hand, table)",
				"move(opponent_hand, opponent_table)",
				"trigger('hand_over')"
			]
		}
	],
	"actions": {
		"Pass": {
			"phase": "upcard",
			"steps": [
				{
					"if": "passes == 0",
					"then": [
						"passes = 1",
						"end_turn()"
					],
					"else": [
						"phase = 'stock_only'",
						"end_turn()"
					]
				}
			]
		},
		"Knock": {
			"when": "count(movable(hand, knock)) > 0",
			"choose": "movable(hand, knock)",
			"steps": [
				"try_move(card, knock)"
			]
		},
		"Big Gin": {
			"phase": "discard",
			"when": "count(deadwood(hand)) == 0",
			"steps": [
				"phase = 'over'",
				"defender_deadwood = sum(deadwood(opponent_hand), 'points')",
				"result = 'big gin'",
				"score += 31 + defender_deadwood",
				"hands_won += 1",
				"move(hand, table)",
				"move(opponent_hand, opponent_table)",
				"trigger('hand_over')"
			]
		},
		"Next hand": {
			"phase": "over",
			"human_only": true,
			"steps": [
				"dealer = 3 - dealer",
				"trigger('deal')"
			]
		},
		"Sort by suit": [
			"sort(hand, ['suit', 'value'])"
		],
		"Sort by rank": [
			"sort(hand, ['value', 'suit'])"
		]
	},
	"triggers": {
		"start": [
			"sort(hand_1, ['value', 'suit'])",
			"sort(hand_2, ['value', 'suit'])",
			"trigger('deal')"
		],
		"deal": [
			"move([hand_1, hand_2, table_1, table_2, discard, knock], stock)",
			"shuffle(stock)",
			"player = 3 - dealer",
			"deal(stock, [hand, opponent_hand], 10)",
			"move(top(stock), discard)",
			"phase = 'upcard'",
			"passes = 0",
			"taken = null",
			"result = ''",
			"knocker_deadwood = 0",
			"defender_deadwood = 0"
		],
		"hand_over": [
			{
				"if": "score_1 >= 100 or score_2 >= 100",
				"then": [
					{
						"if": "score_1 >= 100",
						"then": [
							"player = 1"
						],
						"else": [
							"player = 2"
						]
					},
					"winner = player",
					"score += 100 + 25 * hands_won",
					"opponent_score += 25 * opponent_hands_won",
					{
						"if": "opponent_hands_won == 0",
						"then": [
							"score = score * 2",
							"result += ', shutout'"
						]
					},
					"phase = 'match over'"
				]
			}
		]
	},
	"card_face": {
		"corner": "name",
		"title": "name",
		"body": [
			"suit"
		],
		"color": "color"
	}
}