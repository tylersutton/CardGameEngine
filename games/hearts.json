{
	"players": 4,
	"zones": {
		"deck": { "layout": "pile", "face": "down", "anchor": [0.92, 0.9], "cards": "res://decks/hearts_deck.csv" },
		"hand": {
			"per_player": true, "layout": "fan", "face": "human", "width": 0.5,
			"anchors": [[0.5, 0.86], [0.09, 0.5], [0.5, 0.14], [0.91, 0.5]],
			"rotations": [0, 90, 180, 270]
		},
		"played": { "per_player": true, "layout": "pile", "anchors": [[0.5, 0.62], [0.37, 0.5], [0.5, 0.38], [0.63, 0.5]] },
		"passing": { "per_player": true, "layout": "pile", "face": "human", "anchors": [[0.22, 0.86], [0.09, 0.14], [0.78, 0.14], [0.91, 0.86]] },
		"won": { "per_player": true, "layout": "pile", "face": "down", "anchors": [[0.78, 0.86], [0.22, 0.14], [0.91, 0.14], [0.09, 0.86]] }
	},
	"variables": { "phase": "pass", "passed": 0, "lead": "", "hearts_broken": false, "tricks": 0 },
	"player_variables": { "score": 0 },
	"status": { "your points this hand": "sum(won_1, 'points')" },
	"bot": { "players": [2, 3, 4], "prefer": "sum(passing, 'value') - 10 * sum(won, 'points') - sum(played, 'value')" },
	"conditions": {
		"follows_suit": "lead == '' or card.data.suit == lead or count(where(hand, 'suit', lead)) == 0",
		"hearts_allowed": "lead != '' or card.data.suit != 'Hearts' or hearts_broken or count(where(hand, 'suit', 'Hearts')) == count(hand)",
		"two_of_clubs_leads": "tricks > 0 or lead != '' or card.data.name == '2♣'",
		"trick_winner": "owner(highest(where(all_played, 'suit', lead), 'value'))"
	},
	"moves": [
		{
			"from": "hand", "to": "played",
			"when": "phase == 'play' and follows_suit and hearts_allowed and two_of_clubs_leads",
			"then": [
				{ "if": "lead == ''", "then": ["assign('lead', card.data.suit)"] },
				{ "if": "card.data.suit == 'Hearts'", "then": ["assign('hearts_broken', true)"] },
				{ "if": "count(all_played) == 4", "then": ["assign('phase', 'trick done')", "assign('player', trick_winner)"], "else": ["end_turn()"] }
			]
		}
	],
	"actions": {
		"Pass 3": {
			"when": "phase == 'pass'",
			"choose": "hand", "pick": 3,
			"steps": [
				"move(choice, passing)",
				"assign('passed', passed + 1)",
				{ "if": "passed == 4", "then": ["trigger('exchange')"], "else": ["end_turn()"] }
			]
		},
		"Collect trick": {
			"when": "phase == 'trick done'", "human_only": true,
			"steps": [
				"move(all_played, won)",
				"assign('lead', '')",
				"assign('tricks', tricks + 1)",
				{ "if": "count(all_hand) == 0", "then": ["trigger('score_hand')"], "else": ["assign('phase', 'play')"] }
			]
		},
		"Next hand": { "when": "phase == 'hand over'", "human_only": true, "steps": ["trigger('deal')"] }
	},
	"triggers": {
		"start": [
			{ "for": "player", "in": "players", "do": ["sort(hand, ['suit', 'value'])"] },
			"trigger('deal')"
		],
		"deal": [
			"move([all_hand, all_played, all_passing, all_won], deck)",
			"shuffle(deck)",
			"deal(deck, all_hand, 13)",
			"assign('phase', 'pass')",
			"assign('passed', 0)",
			"assign('tricks', 0)",
			"assign('lead', '')",
			"assign('hearts_broken', false)",
			"assign('player', 1)",
			"ask('Pass 3')"
		],
		"turn_start": [{ "if": "phase == 'pass'", "then": ["ask('Pass 3')"] }],
		"exchange": [
			{ "for": "player", "in": "players", "do": ["move(passing, opponent_hand)"] },
			"assign('phase', 'play')",
			"assign('player', owner(top(where(all_hand, 'name', '2♣'))))"
		],
		"score_hand": [
			{ "for": "player", "in": "players", "do": ["assign('score', score + sum(won, 'points'))"] },
			"assign('phase', 'hand over')"
		]
	},
	"card_face": { "corner": "name", "title": "name", "body": ["suit"], "color": "color" }
}
