{
	"title": "Reversi",
	"description": "You play Black against a White bot on an 8 by 8 board. Click an empty square that traps a line of the other color between your new disc and one of yours: every trapped disc flips to your color. A player who can't trap anything passes. When neither can move, the most discs wins.",
	"players": 2,
	"player_names": [
		"Black",
		"White"
	],
	"seats": [
		[
			0.5,
			0.95
		],
		[
			0.5,
			0.05
		]
	],
	"zones": {
		"square": {
			"board": {
				"shape": "square",
				"columns": 8,
				"rows": 8,
				"size": 60,
				"image": "boards/reversi.svg"
			},
			"anchor": [
				0.5,
				0.5
			],
			"outline": false
		},
		"supply": {
			"layout": "pile",
			"outline": false,
			"anchor": [
				0.15,
				0.5
			],
			"cards": "res://decks/reversi.csv"
		}
	},
	"variables": {
		"passes": 0
	},
	"conditions": {
		"black(space)": "count(space) > 0 and count(face_down(space)) == 0",
		"white(space)": "count(face_down(space)) > 0",
		"mine(space)": "black(space) if player == 1 else white(space)",
		"theirs(space)": "white(space) if player == 1 else black(space)",
		"captures(space)": "flanked(space, 'theirs', 'mine')",
		"discs": "count(zones_where(square, 'mine'))"
	},
	"actions": {
		"Place": {
			"click": "square",
			"when": "count(clicked_zone) == 0 and count(captures(clicked_zone)) > 0",
			"steps": [
				"flip(captures(clicked_zone))",
				"draw(supply, clicked_zone)",
				{
					"if": "player == 2",
					"then": [
						"flip(clicked_zone)"
					]
				}
			]
		}
	},
	"turn": [
		"placed = offer(['Place'])",
		{
			"if": "placed == null",
			"then": [
				"passes += 1"
			],
			"else": [
				"passes = 0"
			]
		},
		{
			"if": "passes == 2",
			"then": [
				"end_game(players_with_most('discs'))"
			]
		},
		"end_turn()"
	],
	"triggers": {
		"start": [
			"draw(supply, space_at(square, 4, 4))",
			"flip(space_at(square, 4, 4))",
			"draw(supply, space_at(square, 5, 4))",
			"draw(supply, space_at(square, 4, 5))",
			"draw(supply, space_at(square, 5, 5))",
			"flip(space_at(square, 5, 5))"
		]
	},
	"status": {
		"discs": "'Black %d, White %d' % [count(zones_where(square, 'black')), count(zones_where(square, 'white'))]"
	},
	"bot": {
		"players": [
			2
		],
		"prefer": "discs"
	},
	"card_face": {
		"shape": "disc",
		"size": 50,
		"background": "#1b1b1b",
		"back": "#f4f4f4"
	}
}