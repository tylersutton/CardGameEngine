{
	"title": "Reversi",
	"description": "You play Black against a White bot on an 8 by 8 board. Place a disc on an empty square (click it, or drag a disc there from the pile) so that it traps a line of the other color between your new disc and one of yours: every trapped disc flips to your color. A player who can't trap anything passes. When neither can move, the most discs wins.",
	"players": 2,
	"player_names": [
		"Black",
		"White"
	],
	"seats": [
		[
			0.5,
			0.95
		],
		[
			0.5,
			0.05
		]
	],
	"zones": {
		"square": {
			"board": {
				"shape": "square",
				"columns": 8,
				"rows": 8,
				"size": 60,
				"image": "boards/reversi.svg"
			},
			"anchor": [
				0.5,
				0.5
			],
			"outline": false
		},
		"box": {
			"layout": "pile",
			"outline": false,
			"anchor": [
				-0.3,
				0.5
			],
			"cards": "res://decks/reversi.csv"
		},
		// Each player's own discs, shown in their color.
		"supply": {
			"per_player": true,
			"layout": "pile",
			"outline": false,
			"anchors": [
				[
					0.15,
					0.75
				],
				[
					0.85,
					0.25
				]
			]
		}
	},
	"variables": {
		"passes": 0
	},
	"conditions": {
		"black(space)": "count(space) > 0 and count(face_down(space)) == 0",
		"white(space)": "count(face_down(space)) > 0",
		"mine(space)": "black(space) if player == 1 else white(space)",
		"theirs(space)": "white(space) if player == 1 else black(space)",
		"captures(space)": "flanked(space, 'theirs', 'mine')",
		"can_place(space)": "count(space) == 0 and count(captures(space)) > 0",
		"discs": "count(zones_where(square, 'mine'))"
	},
	"actions": {
		"Place": {
			"click": "square",
			"when": "can_place(clicked_zone)",
			"steps": [
				"flip(captures(clicked_zone))",
				"draw(supply if count(supply) > 0 else opponent_supply, clicked_zone)",
				{
					"if": "player == 2",
					"then": [
						"flip(clicked_zone)"
					]
				}
			]
		},
		"Place by dragging": {
			"drag": {
				"from": "supply",
				"to": "square"
			},
			"when": "can_place(to)",
			"steps": [
				"flip(captures(to))",
				{
					"if": "player == 2",
					"then": [
						"flip(card)"
					]
				}
			]
		}
	},
	"turn": [
		"placed = offer(['Place', 'Place by dragging'])",
		{
			"if": "placed == null",
			"then": [
				"passes += 1"
			],
			"else": [
				"passes = 0"
			]
		},
		{
			"if": "passes == 2",
			"then": [
				"end_game(players_with_most('discs'))"
			]
		},
		"end_turn()"
	],
	"triggers": {
		"start": [
			"deal(box, all_supply, 32)",
			"flip(supply[2])",
			"draw(supply[2], space_at(square, 4, 4))",
			"flip(space_at(square, 4, 4))",
			"draw(supply[1], space_at(square, 5, 4))",
			"draw(supply[1], space_at(square, 4, 5))",
			"draw(supply[2], space_at(square, 5, 5))",
			"flip(space_at(square, 5, 5))",
			"player = one_of(players)"
		]
	},
	"status": {
		"you play": "lookup(['Black', 'White'], viewer() - 1)",
		"discs": "'Black %d, White %d' % [count(zones_where(square, 'black')), count(zones_where(square, 'white'))]"
	},
	"bot": {
		"players": [
			2
		],
		"prefer": "discs"
	},
	"card_face": {
		"shape": "disc",
		"size": 50,
		"background": "#1b1b1b",
		"back": "#f4f4f4"
	}
}