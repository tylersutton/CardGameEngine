{
	"title": "Fireworks",
	"description": "Cooperative, in the style of Hanabi: you and a bot partner build five fireworks (Red, Yellow, Green, Blue, White) from 1 to 5. You can see your partner's cards but not your own. Spend a clue to mark all of your partner's cards of one color or number; play a card by dragging it to Play, or discard it for a clue. Three wrong plays and it's over.",
	"how_to_play": [
		"# Goal",
		"Work together with your bot partner to build five fireworks, one per color, each from 1 up to 5. Your score is the number of cards in the fireworks (25 is perfect).",
		"# The catch",
		"- You can see your partner's cards, but not your own. Clues marked on your cards tell you what you know.",
		"# Your turn",
		"Do one of these:",
		"- Clue: press Clue color or Clue number, then click one of your partner's cards. Every card of that color (or number) in their hand gets marked. Uses one clue token.",
		"- Play: drag a card from your hand to Play. If it's the next number of its color, it goes on that firework; if not, it's discarded and you lose a fuse.",
		"- Discard: drag a card to Discard to get a clue token back.",
		"# The end",
		"- Three lost fuses and the fireworks fail.",
		"- The game also ends when all five fireworks are finished, or a round after the deck runs out. Finishing a firework (a 5) earns a clue token."
	],
	"players": 2,
	"player_names": [
		"You",
		"Partner"
	],
	"seats": [
		[
			0.19,
			0.84
		],
		[
			0.19,
			0.16
		]
	],
	"zones": {
		"deck": {
			"label": "Deck",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.07,
				0.5
			],
			"cards": "res://decks/fireworks_deck.csv"
		},
		"firework": {
			"labels": [
				"Red",
				"Yellow",
				"Green",
				"Blue",
				"White"
			],
			"copies": 5,
			"layout": "pile",
			"anchor": [
				0.2,
				0.5
			],
			"grid": {
				"columns": 5,
				"spacing": [
					0.09,
					0
				]
			}
		},
		"play": {
			"label": "Play",
			"layout": "pile",
			"anchor": [
				0.68,
				0.5
			]
		},
		"discard": {
			"label": "Discard",
			"layout": "row",
			"width": 0.2,
			"anchor": [
				0.86,
				0.5
			]
		},
		"hand": {
			"per_player": true,
			"layout": "row",
			"face": "others",
			"anchors": [
				[
					0.5,
					0.84
				],
				[
					0.5,
					0.16
				]
			]
		}
	},
	"variables": {
		"clues": 8,
		"fuses": 3,
		"final_turns": -1,
		"result": ""
	},
	"show_variables": [
		"clues",
		"fuses",
		"result"
	],
	"status": {
		"score": "count(firework)",
		"cards left": "count(deck)"
	},
	"bot": {
		"players": [
			2
		],
		"prefer": "10 * count(firework) - 15 * (3 - fuses) + 0.5 * clues + 3 * count(matching(opponent_hand, 'hinted_playable')) - 4 * count(matching(discard, 'is_five'))",
		"samples": 20
	},
	"conditions": {
		"firework_of_card": "zone('firework', int(number(card, 'slot')))",
		"playable": "number(card, 'number') == count(firework_of_card) + 1",
		"hinted_playable": "playable and (mark_of(card, 'color') != null or mark_of(card, 'number') != null)",
		"is_five": "card.data.number == '5'"
	},
	"actions": {
		"Play": {
			"drag": {
				"from": "hand",
				"to": "play"
			},
			"steps": [
				{
					"if": "playable",
					"then": [
						"move(card, firework_of_card)",
						{
							"if": "is_five and clues < 8",
							"then": [
								"clues += 1"
							]
						}
					],
					"else": [
						"move(card, discard)",
						"fuses -= 1"
					]
				},
				"draw(deck, hand)"
			]
		},
		"Discard": {
			"drag": {
				"from": "hand",
				"to": "discard"
			},
			"when": "clues < 8",
			"steps": [
				"clues += 1",
				"draw(deck, hand)"
			]
		},
		"Clue color": {
			"choose": "opponent_hand",
			"when": "clues > 0",
			"steps": [
				"mark(where(opponent_hand, 'color', text(choice, 'color')), 'color', text(choice, 'color'))",
				"clues -= 1"
			]
		},
		"Clue number": {
			"choose": "opponent_hand",
			"when": "clues > 0",
			"steps": [
				"mark(where(opponent_hand, 'number', text(choice, 'number')), 'number', text(choice, 'number'))",
				"clues -= 1"
			]
		}
	},
	"turn": [
		"offer(['Play', 'Discard', 'Clue color', 'Clue number'])",
		"trigger('end_of_turn')"
	],
	"triggers": {
		"start": [
			"shuffle(deck)",
			"deal(deck, all_hand, 5)",
			"player = one_of(players)"
		],
		"end_of_turn": [
			{
				"if": "final_turns > 0",
				"then": [
					"final_turns -= 1"
				]
			},
			{
				"if": "final_turns == -1 and count(deck) == 0",
				"then": [
					"final_turns = 2"
				]
			},
			{
				"if": "final_turns == 0 or fuses == 0 or count(firework) == 25",
				"then": [
					"trigger('game_over')"
				],
				"else": [
					"end_turn()"
				]
			}
		],
		"game_over": [
			"end_game()",
			{
				"if": "fuses == 0",
				"then": [
					"result = 'Boom! Out of fuses'"
				],
				"else": [
					"result = '%d of 25' % count(firework)"
				]
			}
		]
	},
	"card_face": {
		"corner": "number",
		"title": "number",
		"body": [
			"color"
		],
		"color": "ink"
	}
}