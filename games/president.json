{
	"title": "President",
	"description": "Four players, you against three bots. Play a single, pair, triple or four of a kind that beats or matches the last one (matching skips the next player), or pass. 2s are high, and a single 2 beats anything (except as the first play of a hand). Get rid of your cards first to become President.",
	"players": 4,
	"player_names": ["You", "West", "North", "East"],
	"seats": [[0.236, 0.86], [0.09, 0.247], [0.78, 0.14], [0.91, 0.753]],
	"zones": {
		"deck": { "outline": false, "layout": "pile", "face": "down", "anchor": [0.7, 0.5], "cards": "res://decks/president_deck.csv" },
		"hand": {
			"per_player": true, "layout": "fan", "face": "human", "width": 0.45,
			"anchors": [[0.5, 0.86], [0.09, 0.5], [0.5, 0.14], [0.91, 0.5]],
			"rotations": [0, 90, 180, 270]
		},
		"beaten": { "label": "Beaten", "layout": "pile", "anchor": [0.38, 0.5] },
		"table": { "label": "To beat", "layout": "row", "width": 0.2, "anchor": [0.54, 0.5] }
	},
	"variables": {
		"phase": "play", "first_play": true, "set_size": 0, "top_order": 0, "matched": false, "last_played": 0, "passes": 0,
		"finish_order": [], "ranking": [], "result": ""
	},
	"player_variables": { "title": "", "score": 0 },
	"show_variables": ["phase", "result"],
	"status": {
		"You": "'%s (%d points)' % [title_1, score_1]",
		"West": "'%s (%d points)' % [title_2, score_2]",
		"North": "'%s (%d points)' % [title_3, score_3]",
		"East": "'%s (%d points)' % [title_4, score_4]"
	},
	"bot": { "players": [2, 3, 4], "prefer": "-10 * count(hand) + 0.5 * sum(hand, 'order')" },
	"conditions": {
		"is_two": "card.data.rank == '2'",
		"can_beat": "(is_two and not first_play) or (not is_two and number(card, 'order') >= top_order and count(where(hand, 'rank', card.data.rank)) >= max(set_size, 1))",
		"one_rank": "size(groups(choice, 'rank')) == 1",
		"right_size": "set_size == 0 or count(choice) == set_size",
		"single_two": "count(choice) == 1 and text(top(choice), 'rank') == '2'",
		"unbeatable": "top_order == 13",
		"round_over": "set_size > 0 and passes >= count(tops(all_hand)) - int(count(zone('hand', last_played)) > 0)",
		"last_one_left": "owner(top(tops(all_hand)))"
	},
	"actions": {
		"Play": {
			"when": "phase == 'play' and count(hand) > 0",
			"choose": "matching(hand, 'can_beat')", "up_to": 4,
			"allow": "count(choice) > 0 and one_rank and (right_size or single_two)",
			"steps": [
				"move(table, beaten)",
				"move(choice, table)",
				"assign('set_size', count(choice))",
				"assign('matched', number(top(choice), 'order') == top_order)",
				"assign('top_order', number(top(choice), 'order'))",
				"assign('last_played', player)",
				"assign('passes', 0)",
				"assign('first_play', false)",
				{ "if": "count(hand) == 0", "then": ["trigger('finished')"] },
				{ "if": "size(finish_order) == 3", "then": ["assign('player', last_one_left)", "trigger('finished')", "trigger('hand_over')"], "else": [
					{ "if": "unbeatable", "then": ["trigger('clear')", { "if": "count(hand) == 0", "then": ["trigger('next')"] }], "else": ["trigger('next')", { "if": "matched", "then": ["trigger('pass')"] }] }
				] }
			]
		},
		"Pass": {
			"when": "phase == 'play' and set_size > 0",
			"steps": ["trigger('pass')"]
		},
		"Give 2 back": {
			"button": false, "choose": "hand", "pick": 2, "prefer": "sum(hand, 'order')",
			"steps": ["move(choice, zone('hand', ranking[3]))"]
		},
		"Give 1 back": {
			"button": false, "choose": "hand", "prefer": "sum(hand, 'order')",
			"steps": ["move(choice, zone('hand', ranking[2]))", "assign('phase', 'play')"]
		},
		"Next hand": { "when": "phase == 'hand over'", "human_only": true, "steps": ["trigger('deal')"] }
	},
	"triggers": {
		"start": [
			{ "for": "player", "in": "players", "do": ["sort(hand, ['order', 'suit'])"] },
			"trigger('deal')"
		],
		"deal": [
			"move([all_hand, table, beaten], deck)",
			"shuffle(deck)",
			"deal(deck, all_hand, 13)",
			"assign('finish_order', [])",
			"assign('first_play', true)",
			"assign('set_size', 0)",
			"assign('top_order', 0)",
			"assign('passes', 0)",
			{
				"if": "size(ranking) == 0",
				"then": ["assign('phase', 'play')", "assign('player', owner(top(where(all_hand, 'name', '3♣'))))"],
				"else": ["trigger('exchange')"]
			}
		],
		"exchange": [
			"assign('phase', 'exchange')",
			"move(highest(zone('hand', ranking[3]), 'order'), zone('hand', ranking[0]))",
			"move(highest(zone('hand', ranking[3]), 'order'), zone('hand', ranking[0]))",
			"move(highest(zone('hand', ranking[2]), 'order'), zone('hand', ranking[1]))",
			"assign('player', ranking[3])",
			"ask('Give 2 back', ranking[0])",
			"ask('Give 1 back', ranking[1])"
		],
		"clear": ["move([table, beaten], deck)", "assign('set_size', 0)", "assign('top_order', 0)", "assign('passes', 0)"],
		"pass": [
			"assign('passes', passes + 1)",
			"trigger('next')",
			{ "if": "round_over", "then": ["trigger('clear')"] }
		],
		"next": [
			"end_turn()",
			{ "while": "count(hand) == 0", "do": ["end_turn()"] }
		],
		"finished": [
			"assign('finish_order', finish_order + [player])",
			"assign('title', ['President', 'Vice President', 'Vice Scum', 'Scum'][size(finish_order) - 1])",
			"assign('score', score + 4 - size(finish_order))"
		],
		"hand_over": [
			"assign('ranking', finish_order)",
			"assign('phase', 'hand over')"
		]
	},
	"card_face": { "corner": "name", "title": "name", "body": ["suit"], "color": "color" }
}
