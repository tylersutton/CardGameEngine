{
	"title": "Dominion",
	"description": "Deckbuilding: buy cards to grow a better deck. You against a Big Money bot. Change \"kingdom\" in the game file to play with other cards.",
	"players": 2,
	"player_names": [
		"You",
		"Bot"
	],
	"seats": [
		[
			0.07,
			0.75
		],
		[
			0.93,
			0.11
		]
	],
	"zones": {
		"box": {
			"outline": false,
			"layout": "pile",
			"face": "down",
			"anchor": [
				-0.3,
				0.5
			],
			"cards": "res://decks/dominion.csv"
		},
		"chosen": {
			"outline": false,
			"layout": "pile",
			"anchor": [
				-0.3,
				0.5
			]
		},
		"trash": {
			"label": "Trash",
			"layout": "pile",
			"anchor": [
				0.55,
				0.3
			]
		},
		"basic_pile": {
			"label": "Empty",
			"copies": 7,
			"group": "supply",
			"layout": "pile",
			"anchor": [
				0.05,
				0.11
			],
			"grid": {
				"columns": 7,
				"spacing": [
					0.09,
					0
				]
			},
			"on_click": [
				"try_move(card, discard)"
			]
		},
		"kingdom_pile": {
			"label": "Empty",
			"copies": 10,
			"group": "supply",
			"layout": "pile",
			"anchor": [
				0.05,
				0.49
			],
			"grid": {
				"columns": 5,
				"spacing": [
					0.09,
					-0.19
				]
			},
			"on_click": [
				"try_move(card, discard)"
			]
		},
		"deck": {
			"label": "Deck",
			"per_player": true,
			"layout": "pile",
			"face": "down",
			"anchors": [
				[
					0.07,
					0.88
				],
				[
					0.72,
					0.11
				]
			]
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"anchors": [
				[
					0.5,
					0.88
				],
				[
					0.8,
					0.3
				]
			],
			"width": 0.6,
			"on_click": [
				"try_move(card, play)"
			]
		},
		"play": {
			"per_player": true,
			"layout": "row",
			"anchors": [
				[
					0.5,
					0.67
				],
				[
					0.78,
					0.49
				]
			],
			"width": 0.5
		},
		"discard": {
			"label": "Discard",
			"per_player": true,
			"layout": "pile",
			"anchors": [
				[
					0.93,
					0.88
				],
				[
					0.82,
					0.11
				]
			]
		}
	},
	"variables": {
		"phase": "action",
		"actions": 1,
		"buys": 1,
		"coins": 0,
		"result": "",
		"attacker": 0,
		"empty_piles": 0,
		"gain_limit": 0,
		"merchants": 0,
		"silver_played": false
	},
	"show_variables": [
		"phase",
		"actions",
		"buys",
		"coins",
		"result"
	],
	"player_variables": {
		"score": 0,
		"immune": false
	},
	"status": {
		"victory points": "'%s %d, %s %d' % [name_of(1), sum([deck_1, hand_1, play_1, discard_1], 'vp'), name_of(2), sum([deck_2, hand_2, play_2, discard_2], 'vp')]"
	},
	"bot": {
		"players": [
			2
		],
		"prefer": "20 * (sum(my_cards, 'coins') - count(matching(my_cards, 'is_copper'))) / count(my_cards) + 4 * min(count(matching(my_cards, 'is_terminal')), floor(count(my_cards) / 10)) + 3 * min(sum(my_cards, 'cards'), count(matching(my_cards, 'is_action'))) / count(my_cards) * 10 + sum(my_cards, 'vp') + 0.01 * coins"
	},
	"conditions": {
		"basics": "['Copper', 'Silver', 'Gold', 'Estate', 'Duchy', 'Province', 'Curse']",
		"kingdom": "['Cellar', 'Moat', 'Merchant', 'Village', 'Workshop', 'Militia', 'Remodel', 'Smithy', 'Market', 'Mine']",
		"is_moat": "card.data.name == 'Moat'",
		"attacked": "player != attacker and not immune",
		"within_limit": "number(card, 'cost') <= gain_limit",
		"treasure_within_limit": "is_treasure and within_limit",
		"is_action": "number(card, 'action') == 1",
		"is_terminal": "is_action and number(card, 'actions') == 0",
		"is_treasure": "card.data.type == 'Treasure'",
		"is_gardens": "card.data.name == 'Gardens'",
		"is_copper": "card.data.name == 'Copper'",
		"my_cards": "[deck, hand, play, discard]",
		"gardens_vp": "count(matching(my_cards, 'is_gardens')) * (count(my_cards) / 10)",
		"affordable": "buys > 0 and coins >= number(card, 'cost')",
		"nothing_left": "buys == 0 and (actions == 0 or phase == 'buy')"
	},
	"moves": [
		{
			"from": "hand",
			"to": "play",
			"phase": "action",
			"when": "actions > 0 and is_action",
			"then": [
				"actions -= 1"
			]
		},
		{
			"from": "hand",
			"to": "play",
			"when": "phase != 'over' and is_treasure",
			"then": [
				"phase = 'buy'"
			]
		},
		{
			"from": "supply",
			"to": "discard",
			"phase": "buy",
			"when": "affordable",
			"then": [
				"buys -= 1",
				"coins -= number(card, 'cost')",
				"phase = 'buy'",
				{
					"if": "nothing_left",
					"then": [
						"trigger('cleanup')"
					]
				}
			]
		}
	],
	"actions": {
		"Play treasures": {
			"when": "phase == 'action' or count(matching(hand, 'is_treasure')) > 0 and phase == 'buy'",
			"steps": [
				{
					"for": "treasure",
					"in": "matching(hand, 'is_treasure')",
					"do": [
						"try_move(treasure, play)"
					]
				},
				"phase = 'buy'"
			]
		},
		"End turn": {
			"when": "phase != 'over'",
			"steps": [
				"trigger('cleanup')"
			]
		},
		"Discard down to 3": {
			"button": false,
			"choose": "hand",
			"pick": "count(hand) - 3",
			"prefer": "sum(hand, 'coins') + count(matching(hand, 'is_action'))",
			"steps": [
				"move(choice, discard)"
			]
		}
	},
	"triggers": {
		"treasure": [
			"coins += number(card, 'coins')"
		],
		"action": [
			"draw(deck, hand, number(card, 'cards'))",
			"actions += number(card, 'actions')",
			"buys += number(card, 'buys')",
			"coins += number(card, 'coins')"
		],
		"council_room": [
			"attacker = player",
			{
				"for": "player",
				"in": "players",
				"do": [
					{
						"if": "player != attacker",
						"then": [
							"draw(deck, hand)"
						]
					}
				]
			}
		],
		"silver": [
			{
				"if": "not silver_played",
				"then": [
					"coins += merchants",
					"silver_played = true"
				]
			}
		],
		"merchant": [
			"merchants += 1"
		],
		"cellar": [
			"discarded = choose_up_to(hand, count(hand), 'Cellar: discard any number of cards, then draw that many')",
			"move(discarded, discard)",
			"draw(deck, hand, count(discarded))"
		],
		"chapel": [
			"move(choose_up_to(hand, 4, 'Chapel: trash up to 4 cards'), trash)"
		],
		"workshop": [
			"gain_limit = 4",
			"move(choose(matching(tops(supply), 'within_limit'), 'Workshop: gain a card costing up to 4'), discard)"
		],
		"remodel": [
			"trashed = choose(hand, 'Remodel: trash a card from your hand')",
			"move(trashed, trash)",
			"gain_limit = number(trashed, 'cost') + 2",
			"move(choose(matching(tops(supply), 'within_limit'), 'Remodel: gain a card costing up to %d' % gain_limit), discard)"
		],
		"mine": [
			"trashed = choose_up_to(matching(hand, 'is_treasure'), 1, 'Mine: trash a treasure from your hand')",
			{
				"if": "count(trashed) == 1",
				"then": [
					"move(trashed, trash)",
					"gain_limit = number(top(trashed), 'cost') + 3",
					"move(choose(matching(tops(supply), 'treasure_within_limit'), 'Mine: gain a treasure costing up to %d into your hand' % gain_limit), hand)"
				]
			}
		],
		"throne_room": [
			"doubled = choose_up_to(matching(hand, 'is_action'), 1, 'Throne Room: play an action from your hand twice')",
			{
				"if": "count(doubled) == 1",
				"then": [
					"move(doubled, play)",
					"run_effect(top(doubled), 'play')"
				]
			}
		],
		"militia": [
			"attacker = player",
			"trigger('reactions')",
			{
				"for": "player",
				"in": "players",
				"do": [
					{
						"if": "attacked and count(hand) > 3",
						"then": [
							"ask('Discard down to 3', player)"
						]
					},
					"immune = false"
				]
			}
		],
		"witch": [
			"attacker = player",
			"trigger('reactions')",
			{
				"for": "player",
				"in": "players",
				"do": [
					{
						"if": "attacked",
						"then": [
							"move(top(zone('basic_pile', 7)), discard)"
						]
					},
					"immune = false"
				]
			}
		],
		"start": [
			{
				"for": "name",
				"in": "basics",
				"do": [
					"move(where(box, 'name', name), zone('basic_pile', name_number))"
				]
			},
			"sort(chosen, ['cost', 'name'])",
			{
				"for": "name",
				"in": "kingdom",
				"do": [
					"move(where(box, 'name', name), chosen)"
				]
			},
			{
				"for": "pile",
				"in": "kingdom_pile",
				"do": [
					"move(where(chosen, 'name', text(lowest(chosen, 'cost'), 'name')), pile)"
				]
			},
			"deal(zone('basic_pile', 1), all_deck, 7)",
			"deal(zone('basic_pile', 4), all_deck, 3)",
			{
				"for": "player",
				"in": "players",
				"do": [
					"sort(hand, ['type', 'cost'])",
					"shuffle(deck)",
					"draw(deck, hand, 5)"
				]
			}
		],
		"deck_empty": [
			"move(discard, deck)",
			"shuffle(deck)"
		],
		"reactions": [
			{
				"for": "player",
				"in": "players",
				"do": [
					{
						"if": "player != attacker and count(matching(hand, 'is_moat')) > 0",
						"then": [
							"immune = choose(['Reveal Moat', 'Keep it hidden'], 'Moat: reveal it to block the attack?') == 'Reveal Moat'"
						]
					}
				]
			}
		],
		"cleanup": [
			"move(play, discard)",
			"move(hand, discard)",
			"draw(deck, hand, 5)",
			"actions = 1",
			"buys = 1",
			"coins = 0",
			"phase = 'action'",
			"merchants = 0",
			"silver_played = false",
			"trigger('check_end')",
			{
				"if": "phase != 'over'",
				"then": [
					"end_turn()"
				]
			}
		],
		"check_end": [
			"empty_piles = 0",
			{
				"for": "pile",
				"in": "supply",
				"do": [
					{
						"if": "count(pile) == 0",
						"then": [
							"empty_piles += 1"
						]
					}
				]
			},
			{
				"if": "count(zone('basic_pile', 6)) == 0 or empty_piles >= 3",
				"then": [
					"trigger('final_score')"
				]
			}
		],
		"final_score": [
			{
				"for": "player",
				"in": "players",
				"do": [
					"score = sum(my_cards, 'vp') + gardens_vp"
				]
			},
			"phase = 'over'",
			{
				"if": "score_1 > score_2",
				"then": [
					"result = 'Winner: ' + name_of(1)"
				],
				"else": [
					{
						"if": "score_1 < score_2",
						"then": [
							"result = 'Winner: ' + name_of(2)"
						],
						"else": [
							"result = 'A tie'"
						]
					}
				]
			}
		]
	},
	"card_face": {
		"corner": "cost",
		"title": "name",
		"body": [
			"type"
		],
		"text": "text",
		"color": "ink",
		"zoom": 2.4
	}
}