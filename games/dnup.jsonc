{
	"title": "Dnup",
	"description": "Three to five players, you against bots, racing to empty their hands. Every card has a number at each end, and only the top one counts. On your turn, your set from last turn is discarded, then do one thing: Play a set (cards of one number), which must beat any set of the same size on the table, sending that set back to its owner's hand; add one matching card to someone else's set, which must then beat any set of its new size; take someone else's set into your hand; or rotate your whole hand. Cards taken back into a hand are turned round. First out scores 2 and second out 1, which ends the round. First to 4 points wins.",
	"how_to_play": [
		"# Goal",
		"Empty your hand. First out each round scores 2 points, second out scores 1 (and ends the round). The first to 4 points wins.",
		"# The cards",
		"- Every card has a number at each end. Only the big number on top counts; the small one underneath is what it becomes if the card is turned round.",
		"- A set is one or more cards of the same number. Bigger sets don't beat smaller ones: each size of set is a separate contest.",
		"# Your turn",
		"Your set from your last turn is discarded, then do exactly one of these:",
		"- Play a set: press Play a set, click the cards (all the same number), then Done. If another player has a set of the same size on the table, yours must be higher, and theirs goes back to their hand.",
		"- Add a card: drag one card from your hand onto another player's set of the same number. Their set is now one bigger, so it must beat any other set of its new size (which goes back to its owner).",
		"- Take a set: click another player's set to take it into your hand.",
		"- Rotate hand: turn your whole hand round, so every card shows its other number.",
		"# Turning round",
		"- Whenever cards go back into a hand from the table (taken, or beaten), they are turned round. Plan for the small numbers!",
		"- When you're out, your last set stays on the table until everyone has had another turn."
	],
	"players": [
		4,
		3,
		5
	],
	"player_names": [
		"You",
		"West",
		"North",
		"East",
		"Player 5"
	],
	"seats": [
		[
			0.14,
			0.86
		]
	],
	"zones": {
		// Every card's other way round waits here, as do the cards left out for fewer players.
		"box": {
			"outline": false,
			"layout": "pile",
			"face": "down",
			"anchor": [
				-0.3,
				0.5
			],
			"cards": "res://decks/dnup.csv"
		},
		"deck": {
			"outline": false,
			"layout": "pile",
			"face": "down",
			"anchor": [
				-0.3,
				0.5
			]
		},
		"discard": {
			"label": "Discard",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.5,
				0.42
			]
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"width": 0.34,
			"anchor": [
				0.5,
				0.86
			]
		},
		"set": {
			"label": "Set",
			"per_player": true,
			"layout": "row",
			"width": 0.2,
			"anchor": [
				0.5,
				0.64
			]
		}
	},
	"variables": {
		"first_out": 0,
		"round_ended": false,
		// Turns left before the first player out's set is discarded.
		"out_set_turns": 0,
		"from_seat": 0,
		"to_seat": 0
	},
	"player_variables": {
		"points": 0
	},
	"conditions": {
		"other_side(one)": "top(where(box, 'pair', one.pair))",
		"set_value(zone)": "number(top(zone), 'value')",
		"blocks_play(zone)": "count(zone) == count(choice) and set_value(zone) >= number(top(choice), 'value')",
		"beaten_by_play(zone)": "count(zone) == count(choice)",
		"blocks_add(zone)": "zone != to and count(zone) == count(to) + 1 and set_value(zone) >= number(card, 'value')",
		"beaten_by_add(zone)": "zone != to and count(zone) == count(to)",
		"in_play": "card.side == 'top' and card.dots <= size(players) - 2"
	},
	"actions": {
		"Play a set": {
			"choose": "hand",
			"up_to": "count(hand)",
			"allow": "count(choice) > 0 and size(groups(choice, 'value')) == 1 and count(zones_where(all_set, 'blocks_play')) == 0",
			"steps": [
				{
					"for": "beaten",
					"in": "zones_where(all_set, 'beaten_by_play')",
					"do": [
						"from_seat = beaten.owner",
						"trigger('beaten')"
					]
				},
				"log('%s plays %d × %s' % [name_of(player), count(choice), text(top(choice), 'value')])",
				"move(choice, set)",
				"trigger('maybe_out')"
			]
		},
		"Add a card": {
			"drag": {
				"from": "hand",
				"to": "all_set"
			},
			"when": "count(to) > 0 and to.owner != player and card.value == set_value(to) and count(zones_where(all_set, 'blocks_add')) == 0",
			"steps": [
				"log('%s adds a %s to %s\\'s set' % [name_of(player), card.value, name_of(to.owner)])",
				{
					"for": "beaten",
					"in": "zones_where(all_set, 'beaten_by_add')",
					"do": [
						"from_seat = beaten.owner",
						"trigger('beaten')"
					]
				},
				"trigger('maybe_out')"
			]
		},
		"Take a set": {
			"click": "all_set",
			"when": "count(clicked_zone) > 0 and clicked_zone.owner != player",
			"steps": [
				"log('%s takes %s\\'s set' % [name_of(player), name_of(clicked_zone.owner)])",
				"from_seat = clicked_zone.owner",
				"to_seat = player",
				"trigger('turn_round_into_hand')"
			]
		},
		"Rotate hand": {
			"when": "count(hand) > 0",
			"steps": [
				"log('%s rotates their hand' % [name_of(player)])",
				{
					"for": "held",
					"in": "hand",
					"do": "swap(held, other_side(held))"
				}
			]
		},
		"Next round": {
			"human_only": true,
			"steps": []
		}
	},
	"turn": [
		{
			"if": "out_set_turns > 0",
			"then": [
				"out_set_turns -= 1",
				{
					"if": "out_set_turns == 0",
					"then": "move(set[first_out], discard)"
				}
			]
		},
		"move(set, discard)",
		"offer(['Play a set', 'Add a card', 'Take a set', 'Rotate hand'])",
		{
			"if": "round_ended",
			"then": "trigger('next_round')",
			"else": "end_turn()"
		}
	],
	"triggers": {
		"start": [
			{
				"for": "player",
				"in": "players",
				"do": "sort(hand, ['value'])"
			},
			"trigger('deal')"
		],
		"deal": [
			"move([all_hand, all_set, discard], box)",
			"move(matching(box, 'in_play'), deck)",
			"shuffle(deck)",
			"deal(deck, all_hand, 8)",
			"bring_back(players)",
			"reset(['first_out', 'round_ended', 'out_set_turns'])",
			"player = owner(top(where(all_hand, 'star', 'yes')))"
		],
		// The set in front of from_seat goes back into to_seat's hand, each card turned round.
		"turn_round_into_hand": [
			{
				"for": "taken",
				"in": "set[from_seat]",
				"do": "swap(taken, other_side(taken))"
			},
			"move(set[from_seat], hand[to_seat])"
		],
		// A beaten set goes back to its owner, unless they're already out: then it's discarded.
		"beaten": {
			"if": "from_seat == first_out",
			"then": "move(set[from_seat], discard)",
			"else": [
				"to_seat = from_seat",
				"trigger('turn_round_into_hand')"
			]
		},
		"maybe_out": {
			"if": "count(hand) == 0",
			"then": {
				"if": "first_out == 0",
				"then": [
					"log('%s is out first: 2 points' % [name_of(player)])",
					"points += 2",
					"first_out = player",
					"knock_out(player)",
					"out_set_turns = size(players_left()) + 1"
				],
				"else": [
					"log('%s is out second: 1 point, and the round ends' % [name_of(player)])",
					"points += 1",
					"round_ended = true"
				]
			}
		},
		"next_round": [
			"reveal(all_hand)",
			{
				"if": "most('points') >= 4",
				"then": "end_game(players_with_most('points'))"
			},
			"offer('Next round')",
			"trigger('deal')"
		]
	},
	"status": {
		"your points": "points[viewer()]",
		"most points": "most('points')"
	},
	"bot": {
		"players": [
			2,
			3,
			4,
			5
		],
		"prefer": "100 * points - 3 * count(hand) + count(set)"
	},
	"card_face": {
		"corner": "name",
		"title": "value",
		"body": [
			"other"
		],
		"background": "paint",
		"color": "#1b1b1b",
		"card_back": "#37474f"
	}
}