{
	"title": "Goofspiel",
	"description": "Three players, you against two bots, all bidding at once. Each round a diamond is turned up as the prize; everyone secretly bids a card from their suit, then the bids are revealed. The highest bid takes the prize (a tie leaves it for the next round). Most prize points after 13 rounds wins.",
	"players": 3,
	"player_names": ["You", "West", "East"],
	"seats": [[0.16, 0.86], [0.09, 0.18], [0.91, 0.18]],
	"zones": {
		"box": { "outline": false, "layout": "pile", "face": "down", "anchor": [-0.3, 0.5], "cards": "res://decks/standard_deck.csv" },
		"prizes": { "label": "Prizes", "layout": "pile", "face": "down", "anchor": [0.38, 0.32] },
		"prize": { "label": "Prize", "layout": "row", "width": 0.2, "anchor": [0.53, 0.32] },
		"hand": {
			"per_player": true, "layout": "fan", "face": "human", "width": 0.45,
			"anchors": [[0.5, 0.86], [0.09, 0.5], [0.91, 0.5]],
			"rotations": [0, 90, 270]
		},
		"bid": { "label": "Bid", "per_player": true, "layout": "pile", "face": "down", "anchors": [[0.5, 0.62], [0.3, 0.5], [0.7, 0.5]] },
		"won": { "label": "Won", "per_player": true, "layout": "pile", "anchors": [[0.84, 0.86], [0.25, 0.16], [0.75, 0.16]] }
	},
	"variables": { "phase": "bid", "stake": 0, "high": 0, "best": 1, "result": "" },
	"show_variables": ["phase", "result"],
	"status": {
		"points": "'%s %d, %s %d, %s %d' % [name_of(1), sum(won_1, 'value'), name_of(2), sum(won_2, 'value'), name_of(3), sum(won_3, 'value')]",
		"prize worth": "stake"
	},
	"bot": { "players": [2, 3], "prefer": "sum(won, 'value')" },
	"conditions": {
		"high_bids": "where(all_bid, 'value', high)"
	},
	"actions": {
		"Bid": {
			"button": false, "choose": "hand", "prefer": "-abs(sum(bid, 'value') - stake - player + 1)",
			"steps": ["move(choice, bid)"]
		},
		"Next round": {
			"when": "phase == 'revealed'", "human_only": true,
			"steps": ["move(all_bid, box)", { "if": "count(prizes) > 0", "then": ["trigger('round')"], "else": ["trigger('game_over')"] }]
		}
	},
	"triggers": {
		"start": [
			{ "for": "player", "in": "players", "do": [
				"sort(hand, ['value'])",
				"move(where(box, 'suit', ['Spades', 'Hearts', 'Clubs'][player - 1]), hand)"
			] },
			"move(where(box, 'suit', 'Diamonds'), prizes)",
			"shuffle(prizes)",
			"trigger('round')"
		],
		"round": [
			"move(top(prizes), prize)",
			"assign('stake', sum(prize, 'value'))",
			"assign('phase', 'bid')",
			"ask_all('Bid', 'reveal')"
		],
		"reveal": [
			"flip(all_bid)",
			"assign('high', number(highest(all_bid, 'value'), 'value'))",
			{ "if": "count(high_bids) == 1", "then": ["move(prize, zone('won', owner(top(high_bids))))"] },
			"assign('phase', 'revealed')"
		],
		"game_over": [
			"move(prize, box)",
			"assign('phase', 'over')",
			"assign('best', 1)",
			{ "for": "player", "in": "players", "do": [{ "if": "sum(won, 'value') > sum(zone('won', int(best)), 'value')", "then": ["assign('best', player)"] }] },
			"assign('result', 'Winner: ' + name_of(int(best)))"
		]
	},
	"card_face": { "corner": "name", "title": "name", "body": ["suit"], "color": "color" }
}
