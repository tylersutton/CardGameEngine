{
	"title": "President",
	"description": "Four players, you against three bots. Play a single, pair, triple or four of a kind that beats or matches the last one (matching skips the next player), or pass. 2s are high, and a single 2 beats anything (except as the first play of a hand). Get rid of your cards first to become President.",
	"players": 4,
	"player_names": [
		"You",
		"West",
		"North",
		"East"
	],
	"seats": [
		[
			0.215,
			0.86
		]
	],
	"zones": {
		"deck": {
			"outline": false,
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.7,
				0.5
			],
			"cards": "res://decks/standard_deck.csv",
			"columns": {
				"order": "(card.value + 10) % 13 + 1"
			}
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"width": 0.45,
			"anchor": [
				0.5,
				0.86
			]
		},
		"beaten": {
			"label": "Beaten",
			"layout": "pile",
			"anchor": [
				0.38,
				0.5
			]
		},
		"table": {
			"label": "To beat",
			"layout": "row",
			"width": 0.2,
			"anchor": [
				0.54,
				0.5
			]
		}
	},
	"variables": {
		"phase": "play",
		"first_play": true,
		"set_size": 0,
		"top_order": 0,
		"matched": false,
		"last_played": 0,
		"passes": 0,
		"finish_order": [],
		"ranking": [],
		"result": ""
	},
	"player_variables": {
		"title": "",
		"score": 0
	},
	"show_variables": [
		"phase",
		"result"
	],
	"status": {
		"seat 1": "'%s: %s (%d points)' % [name_of(1), title_1, score_1]",
		"seat 2": "'%s: %s (%d points)' % [name_of(2), title_2, score_2]",
		"seat 3": "'%s: %s (%d points)' % [name_of(3), title_3, score_3]",
		"seat 4": "'%s: %s (%d points)' % [name_of(4), title_4, score_4]"
	},
	"bot": {
		"players": [
			2,
			3,
			4
		],
		"prefer": "-10 * count(hand) + 0.5 * sum(hand, 'order')"
	},
	"conditions": {
		"is_two": "card.data.rank == '2'",
		"can_beat": "(is_two and not first_play) or (not is_two and number(card, 'order') >= top_order and count(where(hand, 'rank', card.data.rank)) >= max(set_size, 1))",
		"one_rank": "size(groups(choice, 'rank')) == 1",
		"right_size": "set_size == 0 or count(choice) == set_size",
		"single_two": "count(choice) == 1 and text(top(choice), 'rank') == '2'",
		"unbeatable": "top_order == 13",
		"round_over": "set_size > 0 and passes >= count(tops(all_hand)) - int(count(zone('hand', last_played)) > 0)",
		"last_one_left": "owner(top(tops(all_hand)))"
	},
	"actions": {
		"Play": {
			"choose": "matching(hand, 'can_beat')",
			"up_to": 4,
			"allow": "count(choice) > 0 and one_rank and (right_size or single_two)",
			"when": "phase == 'play' and count(hand) > 0",
			"steps": [
				"move(table, beaten)",
				"move(choice, table)",
				"set_size = count(choice)",
				"matched = number(top(choice), 'order') == top_order",
				"top_order = number(top(choice), 'order')",
				"last_played = player",
				"passes = 0",
				"first_play = false",
				{
					"if": "count(hand) == 0",
					"then": [
						"trigger('finished')"
					]
				},
				{
					"if": "size(finish_order) == 3",
					"then": [
						"player = last_one_left",
						"trigger('finished')",
						"trigger('hand_over')"
					],
					"else": [
						{
							"if": "unbeatable",
							"then": [
								"trigger('clear')",
								{
									"if": "count(hand) == 0",
									"then": [
										"trigger('next')"
									]
								}
							],
							"else": [
								"trigger('next')",
								{
									"if": "matched",
									"then": [
										"trigger('pass')"
									]
								}
							]
						}
					]
				}
			]
		},
		"Pass": {
			"when": "phase == 'play' and set_size > 0",
			"steps": [
				"trigger('pass')"
			]
		},
		"Give 2 back": {
			"button": false,
			"choose": "hand",
			"pick": 2,
			"prefer": "sum(hand, 'order')",
			"steps": [
				"move(choice, zone('hand', ranking[3]))"
			]
		},
		"Give 1 back": {
			"button": false,
			"choose": "hand",
			"prefer": "sum(hand, 'order')",
			"steps": [
				"move(choice, zone('hand', ranking[2]))",
				"phase = 'play'"
			]
		},
		"Next hand": {
			"human_only": true,
			"when": "phase == 'hand over'",
			"steps": [
				"trigger('deal')"
			]
		}
	},
	"triggers": {
		"start": [
			"trigger('deal')",
			{
				"for": "player",
				"in": "players",
				"do": [
					"sort(hand, ['order', 'suit'])"
				]
			}
		],
		"deal": [
			"move([all_hand, table, beaten], deck)",
			"shuffle(deck)",
			"deal(deck, all_hand, 13)",
			"finish_order = []",
			"first_play = true",
			"set_size = 0",
			"top_order = 0",
			"passes = 0",
			{
				"if": "size(ranking) == 0",
				"then": [
					"phase = 'play'",
					"player = owner(top(where(all_hand, 'name', '3♣')))"
				],
				"else": [
					"trigger('exchange')"
				]
			}
		],
		"exchange": [
			"phase = 'exchange'",
			"move(highest(zone('hand', ranking[3]), 'order'), zone('hand', ranking[0]))",
			"move(highest(zone('hand', ranking[3]), 'order'), zone('hand', ranking[0]))",
			"move(highest(zone('hand', ranking[2]), 'order'), zone('hand', ranking[1]))",
			"player = ranking[3]",
			"ask('Give 2 back', ranking[0])",
			"ask('Give 1 back', ranking[1])"
		],
		"clear": [
			"move([table, beaten], deck)",
			"set_size = 0",
			"top_order = 0",
			"passes = 0"
		],
		"pass": [
			"passes += 1",
			"trigger('next')",
			{
				"if": "round_over",
				"then": [
					"trigger('clear')"
				]
			}
		],
		"next": [
			"end_turn()",
			{
				"while": "count(hand) == 0",
				"do": [
					"end_turn()"
				]
			}
		],
		"finished": [
			"finish_order += [player]",
			"title = ['President', 'Vice President', 'Vice Scum', 'Scum'][size(finish_order) - 1]",
			"score += 4 - size(finish_order)"
		],
		"hand_over": [
			"ranking = finish_order",
			"phase = 'hand over'"
		]
	},
	"card_face": {
		"corner": "name",
		"title": "name",
		"body": [
			"suit"
		],
		"color": "color"
	}
}