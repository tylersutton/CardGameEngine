{
	"title": "Dominion",
	"description": "Deckbuilding: buy cards to grow a better deck. You against a Big Money bot. Change \"kingdom\" in the game file to play with other cards.",
	"players": 2,
	"player_names": ["You", "Bot"],
	"seats": [[0.07, 0.75], [0.93, 0.11]],
	"zones": {
		"box": { "outline": false, "layout": "pile", "face": "down", "anchor": [-0.3, 0.5], "cards": "res://decks/dominion.csv" },
		"chosen": { "outline": false, "layout": "pile", "anchor": [-0.3, 0.5] },
		"trash": { "label": "Trash", "layout": "pile", "anchor": [0.55, 0.3] },
		"basic_pile": {
			"label": "Empty", "copies": 7, "group": "supply", "layout": "pile",
			"anchor": [0.05, 0.11], "grid": { "columns": 7, "spacing": [0.09, 0] },
			"on_click": ["try_move(card, discard)"]
		},
		"kingdom_pile": {
			"label": "Empty", "copies": 10, "group": "supply", "layout": "pile",
			"anchor": [0.05, 0.49], "grid": { "columns": 5, "spacing": [0.09, -0.19] },
			"on_click": ["try_move(card, discard)"]
		},
		"deck": { "label": "Deck", "per_player": true, "layout": "pile", "face": "down", "anchors": [[0.07, 0.88], [0.72, 0.11]] },
		"hand": {
			"per_player": true, "layout": "fan", "face": "human", "anchors": [[0.5, 0.88], [0.8, 0.3]], "width": 0.6,
			"on_click": ["try_move(card, play)"]
		},
		"play": { "per_player": true, "layout": "row", "anchors": [[0.5, 0.67], [0.78, 0.49]], "width": 0.5 },
		"discard": { "label": "Discard", "per_player": true, "layout": "pile", "anchors": [[0.93, 0.88], [0.82, 0.11]] }
	},
	"variables": {
		"phase": "action", "actions": 1, "buys": 1, "coins": 0, "result": "",
		"attacker": 0, "empty_piles": 0, "gain_limit": 0, "merchants": 0, "silver_played": false
	},
	"show_variables": ["phase", "actions", "buys", "coins", "result"],
	"player_variables": { "score": 0, "immune": false },
	"status": {
		"victory points": "'%s %d, %s %d' % [name_of(1), sum([deck_1, hand_1, play_1, discard_1], 'vp'), name_of(2), sum([deck_2, hand_2, play_2, discard_2], 'vp')]"
	},
	"bot": { "players": [2], "prefer": "20 * (sum(my_cards, 'coins') - count(matching(my_cards, 'is_copper'))) / count(my_cards) + 4 * min(count(matching(my_cards, 'is_terminal')), floor(count(my_cards) / 10)) + 3 * min(sum(my_cards, 'cards'), count(matching(my_cards, 'is_action'))) / count(my_cards) * 10 + sum(my_cards, 'vp') + 0.01 * coins" },
	"conditions": {
		"basics": "['Copper', 'Silver', 'Gold', 'Estate', 'Duchy', 'Province', 'Curse']",
		"kingdom": "['Cellar', 'Moat', 'Merchant', 'Village', 'Workshop', 'Militia', 'Remodel', 'Smithy', 'Market', 'Mine']",
		"is_moat": "card.data.name == 'Moat'",
		"attacked": "player != attacker and not immune",
		"within_limit": "number(card, 'cost') <= gain_limit",
		"treasure_within_limit": "is_treasure and within_limit",
		"is_action": "number(card, 'action') == 1",
		"is_terminal": "is_action and number(card, 'actions') == 0",
		"is_treasure": "card.data.type == 'Treasure'",
		"is_gardens": "card.data.name == 'Gardens'",
		"is_copper": "card.data.name == 'Copper'",
		"my_cards": "[deck, hand, play, discard]",
		"gardens_vp": "count(matching(my_cards, 'is_gardens')) * (count(my_cards) / 10)",
		"affordable": "buys > 0 and coins >= number(card, 'cost')",
		"nothing_left": "buys == 0 and (actions == 0 or phase == 'buy')"
	},
	"effects": {
		"treasure": ["assign('coins', coins + number(card, 'coins'))"],
		"action": [
			"draw(deck, hand, number(card, 'cards'))",
			"assign('actions', actions + number(card, 'actions'))",
			"assign('buys', buys + number(card, 'buys'))",
			"assign('coins', coins + number(card, 'coins'))"
		],
		"council_room": [
			"assign('attacker', player)",
			{ "for": "player", "in": "players", "do": [{ "if": "player != attacker", "then": ["draw(deck, hand)"] }] }
		],
		"silver": [{ "if": "not silver_played", "then": ["assign('coins', coins + merchants)", "assign('silver_played', true)"] }],
		"merchant": ["assign('merchants', merchants + 1)"],
		"cellar": ["ask('Cellar')"],
		"chapel": ["ask('Chapel')"],
		"workshop": ["assign('gain_limit', 4)", "ask('Gain a card')"],
		"remodel": ["ask('Remodel')"],
		"mine": ["ask('Mine')"],
		"throne_room": ["ask('Throne Room')"],
		"militia": ["assign('attacker', player)", "trigger('reactions')", "ask('Militia attack')"],
		"witch": ["assign('attacker', player)", "trigger('reactions')", "ask('Witch attack')"]
	},
	"moves": [
		{
			"from": "hand", "to": "play",
			"when": "phase == 'action' and actions > 0 and is_action",
			"then": ["assign('actions', actions - 1)"]
		},
		{
			"from": "hand", "to": "play",
			"when": "phase != 'over' and is_treasure",
			"then": ["assign('phase', 'buy')"]
		},
		{
			"from": "supply", "to": "discard",
			"when": "phase == 'buy' and affordable",
			"then": [
				"assign('buys', buys - 1)",
				"assign('coins', coins - number(card, 'cost'))",
				"assign('phase', 'buy')",
				{ "if": "nothing_left", "then": ["trigger('cleanup')"] }
			]
		}
	],
	"actions": {
		"Play treasures": {
			"when": "phase == 'action' or count(matching(hand, 'is_treasure')) > 0 and phase == 'buy'",
			"steps": [{ "for": "treasure", "in": "matching(hand, 'is_treasure')", "do": ["try_move(treasure, play)"] }, "assign('phase', 'buy')"]
		},
		"End turn": { "when": "phase != 'over'", "steps": ["trigger('cleanup')"] },
		"Cellar": {
			"button": false, "choose": "hand", "up_to": "count(hand)",
			"steps": ["move(choice, discard)", "draw(deck, hand, count(choice))"]
		},
		"Chapel": { "button": false, "choose": "hand", "up_to": 4, "steps": ["move(choice, trash)"] },
		"Remodel": {
			"button": false, "choose": "hand",
			"steps": ["move(choice, trash)", "assign('gain_limit', number(choice, 'cost') + 2)", "ask('Gain a card')"]
		},
		"Mine": {
			"button": false, "choose": "matching(hand, 'is_treasure')", "up_to": 1,
			"steps": [{ "if": "count(choice) == 1", "then": ["move(choice, trash)", "assign('gain_limit', number(top(choice), 'cost') + 3)", "ask('Gain a treasure')"] }]
		},
		"Throne Room": {
			"button": false, "choose": "matching(hand, 'is_action')", "up_to": 1,
			"steps": [{ "if": "count(choice) == 1", "then": ["move(choice, play)", "run_effect(top(choice), 'play')"] }]
		},
		"Reveal Moat?": {
			"button": false, "choose": "['Reveal Moat', 'Keep it hidden']",
			"steps": [{ "if": "choice == 'Reveal Moat'", "then": ["assign('immune', true)"] }]
		},
		"Militia attack": {
			"button": false,
			"steps": [{ "for": "player", "in": "players", "do": [
				{ "if": "attacked and count(hand) > 3", "then": ["ask('Discard down to 3', player)"] },
				"assign('immune', false)"
			] }]
		},
		"Discard down to 3": {
			"button": false, "choose": "hand", "pick": "count(hand) - 3",
			"prefer": "sum(hand, 'coins') + count(matching(hand, 'is_action'))",
			"steps": ["move(choice, discard)"]
		},
		"Witch attack": {
			"button": false,
			"steps": [{ "for": "player", "in": "players", "do": [
				{ "if": "attacked", "then": ["move(top(zone('basic_pile', 7)), discard)"] },
				"assign('immune', false)"
			] }]
		},
		"Gain a card": { "button": false, "choose": "matching(tops(supply), 'within_limit')", "steps": ["move(choice, discard)"] },
		"Gain a treasure": { "button": false, "choose": "matching(tops(supply), 'treasure_within_limit')", "steps": ["move(choice, hand)"] }
	},
	"triggers": {
		"start": [
			{ "for": "name", "in": "basics", "do": ["move(where(box, 'name', name), zone('basic_pile', name_number))"] },
			"sort(chosen, ['cost', 'name'])",
			{ "for": "name", "in": "kingdom", "do": ["move(where(box, 'name', name), chosen)"] },
			{ "for": "pile", "in": "kingdom_pile", "do": ["move(where(chosen, 'name', text(lowest(chosen, 'cost'), 'name')), pile)"] },
			"deal(zone('basic_pile', 1), all_deck, 7)",
			"deal(zone('basic_pile', 4), all_deck, 3)",
			{ "for": "player", "in": "players", "do": ["sort(hand, ['type', 'cost'])", "shuffle(deck)", "draw(deck, hand, 5)"] }
		],
		"deck_empty": ["move(discard, deck)", "shuffle(deck)"],
		"reactions": [{ "for": "player", "in": "players", "do": [
			{ "if": "player != attacker and count(matching(hand, 'is_moat')) > 0", "then": ["ask('Reveal Moat?', player)"] }
		] }],
		"cleanup": [
			"move(play, discard)",
			"move(hand, discard)",
			"draw(deck, hand, 5)",
			"assign('actions', 1)",
			"assign('buys', 1)",
			"assign('coins', 0)",
			"assign('phase', 'action')",
			"assign('merchants', 0)",
			"assign('silver_played', false)",
			"trigger('check_end')",
			{ "if": "phase != 'over'", "then": ["end_turn()"] }
		],
		"check_end": [
			"assign('empty_piles', 0)",
			{ "for": "pile", "in": "supply", "do": [{ "if": "count(pile) == 0", "then": ["assign('empty_piles', empty_piles + 1)"] }] },
			{ "if": "count(zone('basic_pile', 6)) == 0 or empty_piles >= 3", "then": ["trigger('final_score')"] }
		],
		"final_score": [
			{ "for": "player", "in": "players", "do": ["assign('score', sum(my_cards, 'vp') + gardens_vp)"] },
			"assign('phase', 'over')",
			{ "if": "score_1 > score_2", "then": ["assign('result', 'Winner: ' + name_of(1))"], "else": [{ "if": "score_1 < score_2", "then": ["assign('result', 'Winner: ' + name_of(2))"], "else": ["assign('result', 'A tie')"] }] }
		]
	},
	"card_face": { "corner": "cost", "title": "name", "body": ["type"], "text": "text", "color": "ink", "zoom": 2.4 }
}
