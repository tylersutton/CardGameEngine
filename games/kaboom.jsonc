{
	"title": "Kaboom",
	"description": "Three players, you against two bots. On your turn, play any action cards you like (drag them to the pile), then draw a card to end your turn. Draw a Bomb without a Defuse and you're out; the last player standing wins. Anyone can answer an action with a Nope, and a Nope can be Noped.",
	"players": 3,
	"player_names": [
		"You",
		"West",
		"East"
	],
	"seats": [
		[
			0.16,
			0.86
		],
		[
			0.09,
			0.18
		],
		[
			0.91,
			0.18
		]
	],
	"zones": {
		"box": {
			"outline": false,
			"layout": "pile",
			"face": "down",
			"anchor": [
				-0.3,
				0.5
			],
			"cards": "res://decks/kaboom_deck.csv"
		},
		"deck": {
			"label": "Deck",
			"layout": "pile",
			"face": "down",
			"anchor": [
				0.4,
				0.42
			]
		},
		"pile": {
			"label": "Pile",
			"layout": "pile",
			"anchor": [
				0.55,
				0.42
			]
		},
		"out": {
			"label": "Out",
			"layout": "pile",
			"anchor": [
				0.85,
				0.86
			]
		},
		"peek": {
			"outline": false,
			"per_player": true,
			"layout": "row",
			"face": "private",
			"width": 0.2,
			"anchors": [
				[
					0.5,
					0.64
				],
				[
					0.3,
					0.2
				],
				[
					0.7,
					0.2
				]
			]
		},
		"hand": {
			"per_player": true,
			"layout": "fan",
			"face": "private",
			"width": 0.45,
			"anchors": [
				[
					0.5,
					0.86
				],
				[
					0.09,
					0.5
				],
				[
					0.91,
					0.5
				]
			],
			"rotations": [
				0,
				90,
				270
			]
		}
	},
	"variables": {
		"phase": "play",
		"pending": "",
		"actor": 0,
		"target": 0,
		"noped": false
	},
	"show_variables": [
		"phase"
	],
	"status": {
		"on the table": "'' if pending == '' else '%s by %s%s' % [pending, name_of(actor), (' (Noped)' if noped else '')]",
		"cards in the deck": "count(deck)"
	},
	"bot": {
		"players": [
			2,
			3
		],
		"prefer": "100 * int(player in players_left()) + 20 * count(matching(hand, 'is_defuse')) + 2 * count(hand)"
	},
	"conditions": {
		"is_defuse": "card.data.kind == 'defuse'",
		"has_nope": "count(where(hand, 'name', 'Nope')) > 0"
	},
	"actions": {
		"Play an action": {
			"drag": {
				"from": "hand",
				"to": "pile"
			},
			"when": "phase == 'play' and card.data.kind == 'action' and pending == ''",
			"steps": [
				"pending = card.data.name",
				"actor = player",
				"noped = false",
				"target = next_player()",
				"ask_others('Nope?', 'resolve')"
			]
		},
		"Draw": {
			"drag": {
				"from": "deck",
				"to": "hand"
			},
			"when": "phase == 'play' and pending == ''",
			"steps": [
				{
					"if": "card.data.kind == 'bomb'",
					"then": [
						{
							"if": "count(matching(hand, 'is_defuse')) > 0",
							"then": [
								"move(top(matching(hand, 'is_defuse')), pile)",
								"move(card, deck)",
								"shuffle(deck)"
							],
							"else": [
								"trigger('knocked_out')"
							]
						}
					]
				},
				{
					"if": "phase == 'play'",
					"then": [
						"end_turn()"
					]
				}
			]
		},
		"Nope?": {
			"button": false,
			"when": "player in players_left() and has_nope",
			"choose": "['Nope!', 'Let it happen']",
			"prefer": "10 * int((noped and target == player) or (not noped and actor == player)) + count(hand)",
			"steps": [
				{
					"if": "choice == 'Nope!'",
					"then": [
						"move(top(where(hand, 'name', 'Nope')), pile)",
						"noped = not noped",
						"ask_others('Nope?', 'resolve')"
					]
				}
			]
		},
		"Give a card": {
			"button": false,
			"choose": "hand",
			"prefer": "20 * count(matching(hand, 'is_defuse')) + 3 * count(where(hand, 'name', 'Nope'))",
			"steps": [
				"move(choice, hand[actor])"
			]
		}
	},
	"triggers": {
		"start": [
			{
				"for": "player",
				"in": "players",
				"do": [
					"sort(hand, ['kind', 'name'])"
				]
			},
			"move(where(box, 'kind', 'action'), deck)",
			"move(where(box, 'kind', 'nope'), deck)",
			"shuffle(deck)",
			{
				"for": "player",
				"in": "players",
				"do": [
					"move(top(where(box, 'kind', 'defuse')), hand)"
				]
			},
			"deal(deck, all_hand, 4)",
			"move(where(box, 'kind', 'defuse'), deck)",
			"move(where(box, 'kind', 'bomb'), deck)",
			"shuffle(deck)",
			"player = random(1, 3)"
		],
		"resolve": [
			{
				"if": "not noped",
				"then": [
					"trigger(pending)"
				]
			},
			"pending = ''"
		],
		"Skip": [
			"end_turn()"
		],
		"Shuffle": [
			"shuffle(deck)"
		],
		"Peek": [
			"move(last(deck, 3), peek)",
			"choose(['Done'], 'Peek: the next three cards, top on the right')",
			"move(all(peek), deck)"
		],
		"Steal": [
			{
				"if": "target != 0",
				"then": [
					"ask('Give a card', target)"
				]
			}
		],
		"knocked_out": [
			"knock_out(player)",
			"move(hand, out)",
			{
				"if": "size(players_left()) == 1",
				"then": [
					"phase = 'over'",
					"end_game(players_left())"
				]
			}
		]
	},
	"card_face": {
		"title": "name",
		"text": "text",
		"color": "color",
		"zoom": 2
	}
}