// Play a matching card: play a card from your hand onto the pile if it matches the top card's suit or rank,
// then the turn passes. Change suit and rank (under Moves) to your deck's columns.
{
	"players": 2,
	"zones": {
		"hand": { "per_player": true, "layout": "fan", "face": "private", "anchor": [0.5, 0.84] },
		"pile": { "label": "Pile", "layout": "pile", "anchor": [0.6, 0.5] }
	},
	"moves": [
		{
			"from": "hand", "to": "pile",
			"when": "count(pile) == 0 or card.suit == text(top(pile), 'suit') or card.rank == text(top(pile), 'rank')",
			"then": "end_turn()"
		}
	]
}
